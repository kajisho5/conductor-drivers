{
 "format": 1,
 "id": "m-nexo-nxamp",
 "name": "NEXO NXAMP",
 "category": "NEXO",
 "version": "2.1.2",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 49280,
   "min": 1,
   "max": 65535
  }
 ],
 "actions": [
  {
   "id": "power",
   "name": "Power Control",
   "options": [
    {
     "id": "power",
     "label": "Power",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "1",
       "label": "On"
      },
      {
       "id": "0",
       "label": "Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "set AMP:Power 0 0 {{option.power|map}}\\n",
    "encoding": "text"
   },
   "maps": {
    "power": {
     "0": "0",
     "1": "1"
    }
   }
  },
  {
   "id": "overMute",
   "name": "Overmute",
   "options": [
    {
     "id": "overmute",
     "label": "Overmute",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "1",
       "label": "On"
      },
      {
       "id": "0",
       "label": "Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "set AMP:Overmute 0 0 {{option.overmute|map}}\\n",
    "encoding": "text"
   },
   "maps": {
    "overmute": {
     "0": "0",
     "1": "1"
    }
   }
  },
  {
   "id": "channelMute",
   "name": "Channel Mute",
   "options": [
    {
     "id": "channelMute",
     "label": "Channel",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 4
    },
    {
     "id": "muteState",
     "label": "Mute",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "1",
       "label": "On"
      },
      {
       "id": "0",
       "label": "Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "set AMP:Ch/Mute {{option.channelMute|lin:1:-1}} 0 {{option.muteState|map}}\\n",
    "encoding": "text"
   },
   "maps": {
    "muteState": {
     "0": "0",
     "1": "1"
    }
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/bitfocus/companion-module-nexo-nxamp",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：Peter Daniel, Phillip Ivan Pietruschka"
  }
 ],
 "source": {
  "module": "nexo-nxamp",
  "version": "2.1.2",
  "license": "MIT",
  "maintainers": [
   "Peter Daniel",
   "Phillip Ivan Pietruschka"
  ],
  "repository": "git+https://github.com/bitfocus/companion-module-nexo-nxamp.git"
 }
}
