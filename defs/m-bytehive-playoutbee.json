{
 "format": 1,
 "id": "m-bytehive-playoutbee",
 "name": "ByteHive PlayoutBee",
 "category": "ByteHive",
 "version": "2.1.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:9000",
   "placeholder": "http://192.168.0.10",
   "mono": true
  }
 ],
 "actions": [
  {
   "id": "play",
   "name": "Play",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/play"
   }
  },
  {
   "id": "pause",
   "name": "Pause",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/pause"
   }
  },
  {
   "id": "stop",
   "name": "Stop",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/stop"
   }
  },
  {
   "id": "next",
   "name": "Next",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/next"
   }
  },
  {
   "id": "previous",
   "name": "Previous",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/prev"
   }
  },
  {
   "id": "select",
   "name": "Select Clip",
   "options": [
    {
     "id": "clip",
     "label": "Clip ID",
     "type": "text",
     "default": "0"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/select/{{option.clip}}"
   }
  },
  {
   "id": "goto",
   "name": "Go to",
   "options": [
    {
     "id": "time",
     "label": "Time",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 999999
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/goto/{{option.time}}"
   }
  },
  {
   "id": "last",
   "name": "Go to last ",
   "options": [
    {
     "id": "time",
     "label": "Time",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 999999
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/last/{{option.time}}"
   }
  },
  {
   "id": "rotate",
   "name": "Set Rotation of Asset",
   "options": [
    {
     "id": "clip",
     "label": "Clip",
     "type": "text",
     "default": "0"
    },
    {
     "id": "rotation",
     "label": "Rotation",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "0",
       "label": "0"
      },
      {
       "id": "90",
       "label": "90"
      },
      {
       "id": "180",
       "label": "180"
      },
      {
       "id": "270",
       "label": "270"
      },
      {
       "id": "360",
       "label": "360"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/asset/{{option.clip}}/rotate/{{option.rotation|map}}0"
   },
   "maps": {
    "rotation": {
     "0": "",
     "90": "9",
     "180": "18",
     "270": "27",
     "360": "36"
    }
   }
  },
  {
   "id": "volume",
   "name": "Set Volume of Asset",
   "options": [
    {
     "id": "clip",
     "label": "Clip",
     "type": "text",
     "default": "0"
    },
    {
     "id": "volume",
     "label": "Volume",
     "type": "text",
     "default": "0"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/asset/{{option.clip}}/volume/{{option.volume}}"
   }
  }
 ],
