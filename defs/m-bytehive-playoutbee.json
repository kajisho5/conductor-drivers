{
 "format": 1,
 "id": "m-bytehive-playoutbee",
 "name": "ByteHive PlayoutBee",
 "category": "ByteHive",
 "version": "2.1.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:9000",
   "placeholder": "http://192.168.0.10",
   "mono": true
  }
 ],
 "actions": [
  {
   "id": "play",
   "name": "Play",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/play"
   }
  },
  {
   "id": "pause",
   "name": "Pause",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/pause"
   }
  },
  {
   "id": "stop",
   "name": "Stop",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/stop"
   }
  },
  {
   "id": "next",
   "name": "Next",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/next"
   }
  },
  {
   "id": "previous",
   "name": "Previous",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/prev"
   }
  },
  {
   "id": "goto",
   "name": "Go to",
   "options": [
    {
     "id": "time",
     "label": "Time",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 999999
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/goto/{{option.time}}"
   }
  },
  {
   "id": "last",
   "name": "Go to last ",
   "options": [
    {
     "id": "time",
     "label": "Time",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 999999
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/last/{{option.time}}"
   }
  },
  {
   "id": "setAction",
   "name": "Set Action of Asset",
   "options": [
    {
     "id": "clip",
     "label": "Clip",
     "type": "text",
     "default": "0"
    },
    {
     "id": "action",
     "label": "Action",
     "type": "select",
     "default": "true",
     "choices": [
      {
       "id": "0",
       "label": "pause"
      },
      {
       "id": "1",
       "label": "playNext"
      },
      {
       "id": "2",
       "label": "next"
      },
      {
       "id": "3",
       "label": "loop"
      },
      {
       "id": "4",
       "label": "reset"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/asset/{{option.clip}}/action/{{option.action|map}}"
   },
   "maps": {
    "action": {
     "0": "0",
     "1": "1",
     "2": "2",
     "3": "3",
     "4": "4",
     "true": "true"
    }
   }
  },
  {
   "id": "volume",
   "name": "Set Volume of Asset",
   "options": [
    {
     "id": "clip",
     "label": "Clip",
     "type": "text",
     "default": "0"
    },
    {
     "id": "volume",
     "label": "Volume",
     "type": "text",
     "default": "0"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/asset/{{option.clip}}/volume/{{option.volume}}"
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "presets": [
  {
   "id": "play",
   "category": "Transport",
   "name": "Play",
   "text": "Play",
   "backgroundColor": "#000000",
   "action": {
    "definitionId": "play",
    "options": {}
   }
  },
  {
   "id": "pause",
   "category": "Transport",
   "name": "Pause",
   "text": "Pause",
   "backgroundColor": "#000000",
   "action": {
    "definitionId": "pause",
    "options": {}
   }
  },
  {
   "id": "stop",
   "category": "Transport",
   "name": "Stop",
   "text": "Stop",
   "backgroundColor": "#000000",
   "action": {
    "definitionId": "stop",
    "options": {}
   }
  }
 ],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（ISC）",
   "url": "https://github.com/bitfocus/companion-module-bytehive-playoutbee",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：Jonas Dautel"
  }
 ],
 "source": {
  "module": "bytehive-playoutbee",
  "version": "2.1.0",
  "license": "ISC",
