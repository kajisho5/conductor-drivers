{
 "format": 1,
 "id": "m-ubiquiti-unifi",
 "name": "Ubiquiti Unifi / USW",
 "category": "Ubiquiti",
 "version": "2.0.3",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "https://192.168.0.10:8443",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "sslverify",
   "label": "SSL Verify",
   "type": "boolean",
   "default": false
  },
  {
   "id": "username",
   "label": "Username",
   "type": "text"
  },
  {
   "id": "password",
   "label": "Password",
   "type": "text"
  },
  {
   "id": "site",
   "label": "Site",
   "type": "text",
   "default": "default"
  }
 ],
 "actions": [
  {
   "id": "POECycle",
   "name": "Switchport: Power Cycle",
   "options": [
    {
     "id": "mac",
     "label": "Switch Mac Address",
     "type": "select",
     "default": "",
     "choices": []
    },
    {
     "id": "port",
     "label": "Port",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 100
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/proxy/network/api/s/default/cmd/devmgr",
    "body": "{\"mac\":\"\",\"port_idx\":{{option.port}},\"cmd\":\"power-cycle\"}",
    "contentType": "application/json"
   }
  },
  {
   "id": "POEMode",
   "name": "Switchport: Set POE mode",
   "options": [
    {
     "id": "mac",
     "label": "Switch Mac Address",
     "type": "select",
     "default": "",
     "choices": []
    },
    {
     "id": "port",
     "label": "Port",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 100
    },
    {
     "id": "mode",
     "label": "Mode",
     "type": "select",
     "default": "auto",
     "choices": [
      {
       "id": "auto",
       "label": "Auto"
      },
      {
       "id": "pasv24",
       "label": "24V Passive"
      },
      {
       "id": "off",
       "label": "Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/proxy/network/api/s/default/stat/device/"
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/bitfocus/companion-module-ubiquiti-unifi",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：Todd Murphy, Julian Waller"
  }
 ],
 "source": {
  "module": "ubiquiti-unifi",
  "version": "2.0.3",
  "license": "MIT",
  "maintainers": [
   "Todd Murphy",
   "Julian Waller"
  ],
  "repository": "git+https://github.com/bitfocus/companion-module-ubiquiti-unifi.git"
 }
}
