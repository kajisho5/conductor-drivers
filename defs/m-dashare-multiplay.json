{
 "format": 1,
 "id": "m-dashare-multiplay",
 "name": "da-share MultiPlay",
 "category": "da-share",
 "version": "2.0.0",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 2000,
   "min": 1,
   "max": 65535
  }
 ],
 "actions": [
  {
   "id": "go",
   "name": "GO",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "go\\n",
    "encoding": "text"
   }
  },
  {
   "id": "stop_all",
   "name": "Stop all cues",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "stop_all\\n",
    "encoding": "text"
   }
  },
  {
   "id": "fade_all",
   "name": "Fade all cues",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "fade_all\\n",
    "encoding": "text"
   }
  },
  {
   "id": "pause_all",
   "name": "Pause all cues",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "pause_all\\n",
    "encoding": "text"
   }
  },
  {
   "id": "resume_all",
   "name": "Resume all cues",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "resume_all\\n",
    "encoding": "text"
   }
  },
  {
   "id": "stopwatch_start",
   "name": "Stopwatch start",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "stopwatch_start\\n",
    "encoding": "text"
   }
  },
  {
   "id": "stopwatch_stop",
   "name": "Stopwatch stop",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "stopwatch_stop\\n",
    "encoding": "text"
   }
  },
  {
   "id": "stopwatch_reset",
   "name": "Stopwatch reset",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "stopwatch_reset\\n",
    "encoding": "text"
   }
  },
  {
   "id": "advance",
   "name": "Advance current GO position",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "advance\\n",
    "encoding": "text"
   }
  },
  {
   "id": "pause",
   "name": "Pause cue",
   "options": [],
   "send": {
    "kind": "bytes",
