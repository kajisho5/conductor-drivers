    "encoding": "text"
   }
  },
  {
   "id": "resume",
   "name": "Resume cue",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "resume\\n",
    "encoding": "text"
   }
  },
  {
   "id": "stop",
   "name": "Stop cue",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "stop\\n",
    "encoding": "text"
   }
  },
  {
   "id": "jump",
   "name": "Jump to near end of cue",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "jump\\n",
    "encoding": "text"
   }
  },
  {
   "id": "next_track",
