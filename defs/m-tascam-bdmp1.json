{
 "format": 1,
 "id": "m-tascam-bdmp1",
 "name": "Tascam BD-MP1",
 "category": "Tascam",
 "version": "1.0.0",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 9030,
   "min": 1,
   "max": 65535
  },
  {
   "id": "placeholder",
   "label": "Variable Placeholder",
   "type": "select",
   "default": "-",
   "choices": [
    {
     "id": "-",
     "label": "Dash (-)"
    },
    {
     "id": "0",
     "label": "Zero (0)"
    }
   ],
   "help": "Character that will be used to fill a variable which is unset."
  }
 ],
 "actions": [
  {
   "id": "stop",
   "name": "Stop",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "!7STP\\r",
    "encoding": "text"
   }
  },
  {
   "id": "play",
   "name": "Play",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "!7PLY\\r",
    "encoding": "text"
   }
  },
  {
   "id": "pause",
   "name": "Pause",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "!7PAS\\r",
    "encoding": "text"
   }
  },
  {
   "id": "chapter_jump",
   "name": "Chapter Jump",
   "options": [
    {
     "id": "chapter",
     "label": "Chapter",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 2000,
     "help": "DVD/BD Chapter, File No (0001-2000)"
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "!7SKP{{option.chapter|pad4}}\\r",
    "encoding": "text"
   }
  },
  {
   "id": "chapter_jump_next",
   "name": "Track/Chapter Jump Next",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "!7SKPNX\\r",
    "encoding": "text"
   }
  },
  {
   "id": "chapter_jump_prev",
   "name": "Track/Chapter Jump Prev",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "!7SKPPV\\r",
    "encoding": "text"
   }
  },
  {
   "id": "title_jump",
   "name": "Title Jump",
   "options": [
    {
     "id": "title",
     "label": "Title",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 2000,
     "help": "DVD/BD Title/CD Track No (0001-2000)"
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "!7GSK{{option.title|pad4}}\\r",
    "encoding": "text"
   }
  },
  {
   "id": "title_jump_next",
   "name": "Title Jump Next",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "!7GSKNX\\r",
    "encoding": "text"
   }
  },
  {
   "id": "title_jump_prev",
   "name": "Title Jump Prev",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "!7GSKPV\\r",
    "encoding": "text"
   }
  },
  {
   "id": "time_mode_code",
   "name": "Time Mode Code",
   "options": [
    {
     "id": "code",
     "label": "Time Mode",
     "type": "select",
     "default": "TL",
     "choices": [
      {
       "id": "TL",
       "label": "Total Elapsed"
      },
      {
       "id": "TR",
       "label": "Total Remain"
      },
      {
       "id": "EL",
       "label": "Elapsed"
      },
      {
       "id": "RM",
       "label": "Remain"
      }
     ],
     "help": "Time Mode"
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "!7TMD{{option.code|map}}\\r",
    "encoding": "text"
   },
   "maps": {
    "code": {
     "TL": "TL",
     "TR": "TR",
     "EL": "EL",
     "RM": "RM"
    }
   }
  },
  {
