{
 "format": 1,
 "id": "m-stagetimerio-api",
 "name": "stagetimer.io Stagetimer API",
 "category": "stagetimer.io",
 "version": "2.3.1",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "https://api.stagetimer.io",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "roomId",
   "label": "Room ID",
   "type": "text",
   "default": "YOUR-ID"
  },
  {
   "id": "apiKey",
   "label": "API Key",
   "type": "text",
   "default": "YOUR-KEY"
  },
  {
   "id": "apiUrl",
   "label": "API URL",
   "type": "text",
   "default": "https://api.stagetimer.io/v1/"
  }
 ],
 "actions": [
  {
   "id": "start",
   "name": "Transport: Start",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/v1/start?room_id=YOUR-ID&api_key=YOUR-KEY"
   }
  },
  {
   "id": "stop",
   "name": "Transport: Stop",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/v1/stop?room_id=YOUR-ID&api_key=YOUR-KEY"
   }
  },
  {
   "id": "start_or_stop",
   "name": "Transport: Start/stop",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/v1/start_or_stop?room_id=YOUR-ID&api_key=YOUR-KEY"
   }
  },
  {
   "id": "reset",
   "name": "Transport: Reset",
   "options": [
    {
     "id": "autostart",
     "label": "Autostart",
     "type": "boolean",
     "default": false,
     "help": "Set to `true` to automatically start the timer after the action is triggered."
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/v1/reset?room_id=YOUR-ID&api_key=YOUR-KEY{{option.autostart|map}}"
   },
   "maps": {
    "autostart": {
     "false": "",
     "true": "&autostart=true"
    }
   }
  },
  {
   "id": "next",
   "name": "Transport: Next",
   "options": [
    {
     "id": "autostart",
     "label": "Autostart",
     "type": "boolean",
     "default": false,
     "help": "Set to `true` to automatically start the timer after the action is triggered."
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/v1/next?room_id=YOUR-ID&api_key=YOUR-KEY{{option.autostart|map}}"
   },
   "maps": {
    "autostart": {
     "false": "",
     "true": "&autostart=true"
    }
   }
  },
  {
   "id": "add_time",
   "name": "Transport: Add time",
   "options": [
    {
     "id": "amount",
     "label": "Amount",
     "type": "text",
     "default": "1m",
     "help": "An amount of time specified by a number followed by a divison of time. Eg. `5s` for 5 seconds, `10m` for 10 minutes, etc."
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/v1/add_time?room_id=YOUR-ID&api_key=YOUR-KEY&amount={{option.amount}}"
   }
  },
  {
   "id": "subtract_time",
   "name": "Transport: Subtract time",
   "options": [
    {
     "id": "amount",
     "label": "Amount",
     "type": "text",
     "default": "1m",
     "help": "An amount of time specified by a number followed by a divison of time. Eg. `5s` for 5 seconds, `10m` for 10 minutes, etc."
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/v1/subtract_time?room_id=YOUR-ID&api_key=YOUR-KEY&amount={{option.amount}}"
   }
  },
  {
   "id": "start_flashing",
   "name": "Viewer: Flash the screen",
   "options": [
    {
     "id": "count",
     "label": "Count",
     "type": "number",
     "default": 3,
     "min": 1,
     "max": 999,
     "help": "Number of times to repeat the action. Accepted numbers: 1 - 999."
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/v1/start_flashing?room_id=YOUR-ID&api_key=YOUR-KEY&count={{option.count}}"
