   "id": "start_timer",
   "name": "Timer: Start",
   "options": [
    {
     "id": "index",
     "label": "Timer index",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 99,
     "help": "Index of a timer to target in a room. Note: Index is not zero-based, it starts at 1. Example: To target the second timer from the top, set `index=2`."
    },
    {
     "id": "timer_id",
     "label": "Timer ID",
     "type": "text",
     "help": "The ID of the timer you want to target."
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/v1/start_timer?room_id=YOUR-ID&api_key=YOUR-KEY&index={{option.index}}&timer_id={{option.timer_id}}"
   }
