{
 "format": 1,
 "id": "m-softron-movierecorder",
 "name": "Softron MovieRecorder",
 "category": "Softron",
 "version": "2.4.1",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:8080",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "useHttps",
   "label": "Use HTTPS",
   "type": "boolean",
   "default": false
  },
  {
   "id": "password",
   "label": "Password (optional)",
   "type": "text",
   "default": ""
  }
 ],
 "actions": [
  {
   "id": "record",
   "name": "Record",
   "options": [],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/sources/record",
    "body": "[]",
    "contentType": "application/json"
   }
  },
  {
   "id": "pause",
   "name": "Pause",
   "options": [],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/sources/pause",
    "body": "[]",
    "contentType": "application/json"
   }
  },
  {
   "id": "resume",
   "name": "Resume",
   "options": [],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/sources/resume",
    "body": "[]",
    "contentType": "application/json"
   }
  },
  {
   "id": "stop",
   "name": "Stop",
   "options": [],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/sources/stop",
    "body": "[]",
    "contentType": "application/json"
   }
  },
  {
   "id": "lock",
   "name": "Lock",
   "options": [
    {
     "id": "source",
     "label": "Source",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/sources//lock"
   }
  },
  {
   "id": "unlock",
   "name": "Unlock",
   "options": [
    {
     "id": "source",
     "label": "Source",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/sources//unlock"
   }
  },
  {
   "id": "split",
   "name": "Split Recording",
   "options": [
    {
     "id": "source",
     "label": "Source",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/sources//manual_split"
   }
  },
  {
   "id": "setRecordingName",
   "name": "Set Recording Name",
   "options": [
    {
     "id": "source",
     "label": "Source",
     "type": "text",
     "default": ""
    },
    {
     "id": "recordName",
     "label": "Recording Name",
     "type": "text",
     "default": "New Recording"
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/sources//recording_name",
    "body": "{\"recording_name\":\"{{option.recordName}}\"}",
    "contentType": "application/json"
   }
  },
  {
   "id": "setRecordingDestination",
   "name": "Set Recording Destination",
   "options": [
    {
     "id": "source",
     "label": "Source",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/sources//destinations",
    "body": "[]",
    "contentType": "application/json"
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/bitfocus/companion-module-softron-movierecorder",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：Bryce Seifert"
  }
 ],
