{
 "format": 1,
 "id": "m-nohassleav-videowallprocessor",
 "name": "NoHassleAV HDP MXB44VW / Video Wall Processor 4x4",
 "category": "NoHassleAV",
 "version": "1.0.0",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 23,
   "min": 1,
   "max": 65535
  },
  {
   "id": "autoReconnect",
   "label": "Auto Reconnect",
   "type": "boolean",
   "default": true
  }
 ],
 "actions": [
  {
   "id": "lock",
   "name": "Device: Lock panel buttons",
   "options": [
    {
     "id": "command",
     "label": "Action",
     "type": "select",
     "default": "lock",
     "choices": [
      {
       "id": "lock",
       "label": "Lock"
      },
      {
       "id": "unlock",
       "label": "Unlock"
      },
      {
       "id": "toggle",
       "label": "Toggle"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "s lock {{option.command|map}}!\\r\\n",
    "encoding": "text"
   },
   "maps": {
    "command": {
     "lock": "1",
     "unlock": "0",
     "toggle": "1"
    }
   }
  },
