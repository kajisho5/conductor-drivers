 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 4647,
   "min": 1,
   "max": 65535
  },
  {
   "id": "prot",
   "label": "Connect with TCP / UDP",
   "type": "select",
   "default": "tcp",
   "choices": [
    {
     "id": "tcp",
     "label": "TCP"
    },
    {
     "id": "udp",
     "label": "UDP"
    }
   ]
  }
 ],
