{
 "format": 1,
 "id": "m-behringer-wing",
 "name": "Behringer WING",
 "category": "Behringer",
 "version": "2.3.0-beta.2",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 2223,
   "min": 1,
   "max": 65535
  },
  {
   "id": "model",
   "label": "Desk Type",
   "type": "select",
   "default": "full",
   "choices": [
    {
     "id": "full",
     "label": "Full"
    },
    {
     "id": "compact",
     "label": "Compact"
    },
    {
     "id": "rack",
     "label": "Rack"
    }
   ],
   "help": "Select the variant of the desk that is connected. Placed for potential future use."
  },
  {
   "id": "fadeUpdateRate",
   "label": "Fader Update Rate (20 updates/sec)",
   "type": "number",
   "default": 50,
   "min": 20,
   "max": 60000,
   "help": "Update rate of the faders in milliseconds. A lower values makes the transitions smoother but increases system load."
  },
  {
   "id": "statusPollUpdateRate",
   "label": "Status Poll Rate (0.33 updates/sec)",
   "type": "number",
   "default": 3000,
   "min": 20,
   "max": 60000,
   "help": "Some values need to be actively requested from the desk, this number sets the interval in milliseconds at which those requests occur."
  },
  {
   "id": "variableUpdateRate",
   "label": "Variable Update Rate (10 updates/sec)",
   "type": "number",
   "default": 100,
   "min": 20,
   "max": 60000,
   "help": "Defines how many milliseconds elapse between variable updates. A lower number makes variables more responsive but may decrease system performance."
  },
  {
   "id": "prefetchVariablesOnStartup",
   "label": "Fetch variables on startup",
   "type": "boolean",
   "default": true,
   "help": "Request values for all variables when establishing a connection to a desk."
  },
  {
   "id": "show-advanced-options",
   "label": "Show advanced options",
   "type": "boolean",
   "default": false,
   "help": "Show advanced configuration options. There is no guarantee that these options will work in any combination."
  },
  {
   "id": "requestTimeout",
   "label": "Request Timeout (ms)",
   "type": "number",
   "default": 200,
   "min": 50,
   "max": 10000,
   "help": "Time in milliseconds to wait for a response to a sent command before considering it lost."
  },
  {
   "id": "panicOnLostRequest",
   "label": "Panic on lost request",
   "type": "boolean",
   "default": false,
   "help": "If enabled, the module will log an error when a sent command does not receive a response within the specified timeframe."
  },
  {
   "id": "startupVariableRequestChunkSize",
   "label": "Variable Request Chunk",
   "type": "number",
   "default": 500,
   "min": 200,
   "max": 2000,
   "help": "When are requested in chunks on startup, waiting between each chunk"
  },
  {
   "id": "startupVariableRequestChunkWait",
   "label": "Variable Request Wait Time (ms)",
   "type": "number",
   "default": 100,
   "min": 20,
   "max": 1000,
   "help": "When are requested in chunks on startup, waiting between each chunk"
  },
  {
   "id": "subscriptionInterval",
   "label": "Subscription Interval (ms)",
   "type": "number",
   "default": 9000,
   "min": 100,
   "max": 9999,
   "help": "Time in milliseconds to wait between subscription requests."
  },
  {
   "id": "enableOscForwarding",
   "label": "Enable OSC Forwarding",
   "type": "boolean",
   "default": false,
   "help": "Forward all received OSC messages to another OSC endpoint"
  },
  {
   "id": "debugMode",
   "label": "Enable Debug Mode",
   "type": "boolean",
   "default": false,
   "help": "Enable detailed logging including timestamps and source location information"
  }
 ],
