{
 "format": 1,
 "id": "m-obsbot-osc",
 "name": "OBSBOT Center App / Tail 2 / Tail Air / Tiny / Tiny 4K / Tiny 2 / Tiny 2 Lite…",
 "category": "OBSBOT",
 "version": "1.1.0",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 57110,
   "min": 1,
   "max": 65535
  },
  {
   "id": "transport",
   "label": "Transport Protocol",
   "type": "select",
   "default": "udp",
   "choices": [
    {
     "id": "udp",
     "label": "UDP"
    },
    {
     "id": "tcp",
     "label": "TCP"
    }
   ]
  },
  {
   "id": "listenport",
   "label": "Listen Port",
   "type": "number",
   "default": 57120,
   "min": 1,
   "max": 65535,
   "help": "Port for receiving OSC messages over UDP. 57120 is the default for OBSBOT devices and Center App"
  },
  {
   "id": "model",
   "label": "Device Model",
   "type": "select",
   "default": "OBSBOT_TAIL_2",
   "choices": [
    {
     "id": "OBSBOT_TAIL_2",
     "label": "OBSBOT Tail 2"
    },
    {
     "id": "OBSBOT_TAIL_AIR",
     "label": "OBSBOT Tail Air"
    },
    {
     "id": "OBSBOT_CENTER",
     "label": "OBSBOT Center App"
    },
    {
     "id": "OBSBOT_CENTER_TINY",
     "label": "OBSBOT Center App (Tiny Series)"
    },
    {
     "id": "OBSBOT_CENTER_TAIL_AIR",
     "label": "OBSBOT Center App (Tail Series - Tail Air)"
    },
    {
     "id": "OBSBOT_CENTER_TAIL_2",
     "label": "OBSBOT Center App (Tail Series - Tail 2)"
    },
    {
     "id": "OBSBOT_CENTER_MEET",
     "label": "OBSBOT Center App (Meet Series)"
    }
   ],
   "help": "Select the model of your OBSBOT device"
  },
  {
   "id": "device",
   "label": "Device ID",
   "type": "number",
   "default": 1,
   "min": 1,
   "max": 255,
   "help": "Device ID for the OBSBOT Center App. This is not used for hardware devices."
  },
  {
   "id": "verbose",
   "label": "Enable Verbose Logging",
   "type": "boolean",
   "default": false
  }
 ],
