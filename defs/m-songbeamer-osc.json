  {
   "id": "state_logo",
   "category": "Presentation state",
   "name": "presentation_state -> logo ",
   "text": "presentation_state -> logo ",
   "backgroundColor": "#000000",
   "action": {
    "definitionId": "presentation_state",
    "options": {
     "presentation_state": "3",
     "should_change": true
    }
   }
  },
  {
