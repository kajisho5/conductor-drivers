{
 "format": 1,
 "id": "m-shelly-http",
 "name": "Shelly 1 / Shelly 2.5 / Shelly Dimmer1/2 / Shelly RGBW2",
 "category": "Shelly",
 "version": "1.0.2",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "pollingInterval",
   "label": "Polling interval (ms)",
   "type": "number",
   "default": 300,
   "min": 100,
   "max": 5000,
   "help": "How often Companion will read the latest data out of the Shelly device (for feedbacks, 100ms - 5s)"
  },
  {
   "id": "shellyProduct",
   "label": "Shelly Product",
   "type": "select",
   "default": "101",
   "choices": [
    {
     "id": "101",
     "label": "Shelly 1"
    },
    {
     "id": "102",
     "label": "Shelly 2.5 Relay Mode"
    },
    {
     "id": "103",
     "label": "Shelly 2.5 Roller Mode"
    },
    {
     "id": "104",
     "label": "Shelly Dimmer 1/2"
    },
    {
     "id": "105",
     "label": "Shelly RGBW2 (Color Mode)"
    },
    {
     "id": "106",
     "label": "Shelly RGBW2 (White Mode)"
    }
   ]
  }
 ],
 "actions": [
  {
   "id": "toggle",
   "name": "Toggle",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/relay/0?turn=toggle"
   }
  },
  {
   "id": "on",
   "name": "Turn on",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/relay/0?turn=on"
   }
  },
  {
   "id": "off",
   "name": "Turn off",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/relay/0?turn=off"
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/bitfocus/companion-module-shelly-http",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：Leon Reucher"
  }
 ],
 "source": {
  "module": "shelly-http",
  "version": "1.0.2",
  "license": "MIT",
  "maintainers": [
   "Leon Reucher"
  ],
  "repository": "git+https://github.com/bitfocus/companion-module-shelly-http.git"
 }
}
