{
 "format": 1,
 "id": "m-riedel-smartpanel",
 "name": "Riedel Communications Smart Panel",
 "category": "Riedel Communications",
 "version": "1.0.1",
 "minAppVersion": "0.6.0",
 "transport": "ws",
 "wsPath": "/websocket",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 80,
   "min": 1,
   "max": 65535
  }
 ],
 "actions": [
  {
   "id": "fetchAlarmHistory",
   "name": "Fetch Alarm History",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"topic\":\"/StatusInfo/FetchAlarmHistory\",\"body\":{}}",
    "encoding": "text"
   }
  },
  {
   "id": "updatePtpSettings",
   "name": "Update PTP Settings",
   "options": [
    {
     "id": "domain",
     "label": "PTP Domain",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 255
    },
    {
     "id": "hybridMode",
     "label": "Hybrid Mode",
     "type": "boolean",
     "default": true
    },
    {
     "id": "timeReceiverOnly",
     "label": "Time Receiver Only",
     "type": "boolean",
     "default": true
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"topic\":\"/Ptp/UpdatePtpSettings\",\"body\":{\"domain\":{{option.domain}},\"hybridMode\":{{option.hybridMode|map}}e,\"timeReceiverOnly\":{{option.timeReceiverOnly|map}}e}}",
    "encoding": "text"
   },
   "maps": {
    "hybridMode": {
     "true": "tru",
     "false": "fals"
    },
    "timeReceiverOnly": {
     "true": "tru",
     "false": "fals"
    }
   }
  },
  {
   "id": "setPtpDomain",
   "name": "Set PTP Domain",
   "options": [
    {
     "id": "domain",
     "label": "PTP Domain",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 255
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"topic\":\"/Ptp/UpdatePtpSettings\",\"body\":{\"domain\":{{option.domain}},\"hybridMode\":true,\"timeReceiverOnly\":true}}",
    "encoding": "text"
   }
  },
  {
   "id": "enableControlPanel",
   "name": "Enable Control Panel",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"topic\":\"/ControlPanelApp/Enable\",\"body\":{}}",
    "encoding": "text"
   }
  },
  {
   "id": "disableControlPanel",
   "name": "Disable Control Panel",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"topic\":\"/ControlPanelApp/Disable\",\"body\":{}}",
    "encoding": "text"
   }
  },
  {
   "id": "toggleControlPanel",
   "name": "Toggle Control Panel",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"topic\":\"/ControlPanelApp/Enable\",\"body\":{}}",
    "encoding": "text"
   }
  },
  {
   "id": "enableNmos",
   "name": "Enable NMOS",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"topic\":\"/Nmos/Enable\",\"body\":{}}",
    "encoding": "text"
   }
  },
  {
   "id": "disableNmos",
   "name": "Disable NMOS",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"topic\":\"/Nmos/Disable\",\"body\":{}}",
    "encoding": "text"
   }
  },
  {
   "id": "toggleNmos",
   "name": "Toggle NMOS",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"topic\":\"/Nmos/Enable\",\"body\":{}}",
    "encoding": "text"
   }
  }
 ],
