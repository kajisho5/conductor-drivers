{
 "format": 1,
 "id": "m-zoom-osc-iso",
 "name": "Zoom OSC/ISO",
 "category": "Zoom",
 "version": "4.9.1",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 9090,
   "min": 1,
   "max": 65535
  },
  {
   "id": "rx_port",
   "label": "ZoomISO/ZoomOSC Transmission Port",
   "type": "number",
   "default": 1234,
   "min": 1,
   "max": 65535
  },
  {
   "id": "selectionMethod",
   "label": "Default selection method",
   "type": "select",
   "default": "1",
   "choices": [
    {
     "id": "1",
     "label": "Single Selection"
    },
    {
     "id": "0",
     "label": "Multi Selection"
    }
   ]
  },
  {
   "id": "numberOfGroups",
   "label": "Number of selectable groups",
   "type": "number",
   "default": 3,
   "min": 0,
   "max": 100
  },
  {
   "id": "pulling",
   "label": "Sync iso configuration time in seconds (only for ZoomISO)",
   "type": "select",
   "default": "1000",
   "choices": [
    {
     "id": "1000",
     "label": "Fast (1 second) - Recommended"
    },
    {
     "id": "2500",
     "label": "Medium (2.5 seconds)"
    },
    {
     "id": "5000",
     "label": "Slow (5 seconds)"
    },
    {
     "id": "10000",
     "label": "Extra Slow (10 seconds)"
    }
   ],
   "help": "How often to update the ZoomISO audioLevels, outputRouting, audioRouting, and engineState"
  },
  {
   "id": "feedbackImagesWithIcons",
   "label": "Participant Multi-State Feedback",
   "type": "select",
   "default": "0",
   "choices": [
    {
     "id": "0",
     "label": "Bottom (On and Off For Mic/Camera, Only on for Hand Raise) - Recommended"
    },
    {
     "id": "2",
     "label": "Bottom (Only Active States)"
    },
    {
     "id": "3",
     "label": "Bottom (On and Off States)"
    },
    {
     "id": "4",
     "label": "Disable - Only If You Do Not Need To See Camera, Mic, and Hand Raised State"
    }
   ],
   "help": "If enabled, adds icons to bottom of button for camera, mic, and hand raised state"
  },
  {
   "id": "enableSocialStream",
   "label": "Enable",
   "type": "boolean",
   "default": false
  },
  {
   "id": "socialStreamId",
   "label": "Session Id for Social Stream",
   "type": "text",
   "default": ""
  },
  {
   "id": "socialStreamQuestionPrefix",
   "label": "Prefix for Zoom Q&A Questions",
   "type": "text",
   "default": ""
  },
  {
   "id": "enableVariablesForEachUser",
   "label": "Enable Variable For Each User",
   "type": "boolean",
   "default": true
  },
  {
   "id": "enableVariablesForParticipants",
   "label": "Enable Variable For Participants",
   "type": "boolean",
   "default": true
  },
  {
   "id": "enableActionPresetAndFeedbackSync",
   "label": "Enable Sync Action/Presets/Feedbacks",
   "type": "boolean",
   "default": true
  }
 ],
