   }
  },
  {
   "id": "right",
   "name": "Right",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23PTS2525&res=1"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/cgi-bin/aw_ptz?cmd=%23RER&res=1"
    }
   ]
  },
  {
   "id": "stopud",
   "name": "Stop Up/Down",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23PTS2550&res=1"
   }
  },
  {
   "id": "stoplr",
   "name": "Stop Left/Right",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23PTS5050&res=1"
   }
  },
  {
