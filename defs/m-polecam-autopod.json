   "name": "Up/Down/Left/Right - Home",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23APC7FFF7FFF&res=1"
   }
  },
  {
   "id": "ptSpeedD",
   "name": "Up/Down/Left/Right - Speed Down",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23RER&res=1"
   }
  },
  {
   "id": "splitDualLeg",
   "name": "Split Dual Leg",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23R10&res=1"
   }
  },
  {
   "id": "singleLeg",
   "name": "Single Leg",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23R11&res=1"
   }
  },
  {
   "id": "dualLeg",
   "name": "Dual Leg",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23R12&res=1"
   }
  },
  {
   "id": "dualLegPancake",
   "name": "Pancake",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23R16&res=1"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/cgi-bin/aw_ptz?cmd=%23AXI&res=1"
    }
   ]
  },
  {
   "id": "autoCalibrate",
   "name": "Set autocalibration",
   "options": [
    {
     "id": "val",
     "label": "Auto calibration",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "0",
       "label": "Off"
      },
      {
       "id": "1",
       "label": "On"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23D1{{option.val|map}}&res=1"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/cgi-bin/aw_ptz?cmd=%23D1&res=1"
    }
   ],
   "maps": {
    "val": {
     "0": "0",
     "1": "1"
    }
   }
  },
  {
   "id": "demoMode",
   "name": "Start Demo Mode",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23R14&res=1"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/cgi-bin/aw_ptz?cmd=%23APC&res=1"
    }
   ]
  },
  {
   "id": "stopDemoMode",
   "name": "Stop Demo Mode",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23R15&res=1"
   }
  },
  {
   "id": "calib",
   "name": "Perform calibration",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23R18&res=1"
   }
  },
  {
   "id": "reboot",
   "name": "Reboot device",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23R19&res=1"
   }
  }
 ],
