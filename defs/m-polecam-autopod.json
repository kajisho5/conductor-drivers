{
 "format": 1,
 "id": "m-polecam-autopod",
 "name": "Polecam Autopod+ / Panapod",
 "category": "Polecam",
 "version": "1.0.3",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "debug",
   "label": "Enable",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "up",
   "name": "Up",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23PTS5075&res=1"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/cgi-bin/aw_ptz?cmd=%23V%3F&res=1"
    }
   ]
  },
  {
   "id": "down",
   "name": "Down",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/aw_ptz?cmd=%23PTS5025&res=1"
   }
  },
  {
   "id": "left",
