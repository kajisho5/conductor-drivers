{
 "format": 1,
 "id": "m-wordnik-api",
 "name": "Wordnik API",
 "category": "Wordnik",
 "version": "1.0.1",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "https://api.wordnik.com",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "apiKey",
   "label": "API Key",
   "type": "text"
  },
  {
   "id": "verbose",
   "label": "Verbose Logs",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "get_wotd",
   "name": "Word of the day",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/v4/words.json/wordOfTheDay?api_key="
   }
  },
  {
   "id": "random_words",
   "name": "Random Words",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/v4/words.json/randomWords?api_key="
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/bitfocus/companion-module-wordnik-api",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：Phillip Ivan Pietruschka"
  }
 ],
