{
 "format": 1,
 "id": "m-anomes-millumin",
 "name": "Anomes Millumin 2 / Millumin 3 / Millumin 4",
 "category": "Anomes",
 "version": "4.0.0",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 5000,
   "min": 1,
   "max": 65535
  },
  {
   "id": "rx_port",
   "label": "Receive port",
   "type": "number",
   "default": 8000,
   "min": 1,
   "max": 65535
  },
  {
   "id": "timeLayerName",
   "label": "Name of the layer to track time",
   "type": "text",
   "default": "layer"
  },
  {
   "id": "trackMultipleLayers",
   "label": "Enable tracking of multiple layer (comma separated list)",
   "type": "boolean",
   "default": false
  }
 ],
