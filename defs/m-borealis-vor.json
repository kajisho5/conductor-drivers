 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 3049,
   "min": 1,
   "max": 65535
  },
  {
   "id": "osc_id",
   "label": "OSC Instance ID",
   "type": "number",
   "default": 1,
   "min": 1,
   "max": 999
  },
  {
