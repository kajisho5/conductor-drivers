{
 "format": 1,
 "id": "m-bmd-multiview4",
 "name": "Blackmagic Design Multiview 4",
 "category": "Blackmagic Design",
 "version": "2.0.0",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 9990,
   "min": 1,
   "max": 65535
  }
 ],
 "actions": [
  {
   "id": "mode",
   "name": "Display Mode",
   "options": [
    {
     "id": "setting",
     "label": "Display Mode",
     "type": "select",
     "default": "true",
     "choices": [
      {
       "id": "true",
       "label": "SOLO"
      },
      {
       "id": "false",
       "label": "2x2"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "CONFIGURATION:\\nSolo enabled: {{option.setting|map}}e\\n\\n\\n\\n",
    "encoding": "text"
   },
   "maps": {
    "setting": {
     "true": "tru",
     "false": "fals"
    }
   }
  },
  {
   "id": "audio",
   "name": "Audio from Input",
