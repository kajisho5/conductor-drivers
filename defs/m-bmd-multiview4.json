      {
       "id": "1",
       "label": "Input 2"
      },
      {
       "id": "2",
       "label": "Input 3"
      },
      {
       "id": "3",
       "label": "Input 4"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "VIDEO OUTPUT ROUTING:\\n5 {{option.inp|map}}\\n\\n\\n\\n",
    "encoding": "text"
   },
   "maps": {
    "inp": {
     "0": "0",
     "1": "1",
     "2": "2",
     "3": "3"
    }
