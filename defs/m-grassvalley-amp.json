{
 "format": 1,
 "id": "m-grassvalley-amp",
 "name": "Grass Valley AMP",
 "category": "Grass Valley",
 "version": "2.1.0",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 3811,
   "min": 1,
   "max": 65535
  },
  {
   "id": "channel",
   "label": "AMP Channel",
   "type": "text",
   "default": "Vtr1"
  }
 ],
 "actions": [
  {
   "id": "play",
   "name": "Play",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "CMDS00042001\\n",
    "encoding": "text"
   }
  },
  {
   "id": "set_loop",
   "name": "Loop playback (On/Off)",
   "options": [
    {
     "id": "state",
     "label": "State",
     "type": "select",
     "default": "01",
     "choices": [
      {
       "id": "01",
       "label": "On"
      },
      {
       "id": "00",
       "label": "Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "CMDS000641420{{option.state|map}}\\n",
    "encoding": "text"
   },
   "maps": {
    "state": {
     "01": "1",
     "00": "0"
    }
   }
  },
  {
   "id": "stop",
   "name": "Stop",
