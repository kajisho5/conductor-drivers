{
 "format": 1,
 "id": "m-toolsonair-justincapture",
 "name": "ToolsOnAir just:in Capture Solutions",
 "category": "ToolsOnAir",
 "version": "1.1.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:8080",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "enablePolling",
   "label": "Enable Polling",
   "type": "boolean",
   "default": true
  },
  {
   "id": "pollingRate",
   "label": "Polling Rate/Interval (ms)",
   "type": "number",
   "default": 1000,
   "help": "The interval at which the module will poll the server for updates, defined in milliseconds. Default is 1000ms."
  },
  {
   "id": "verbose",
   "label": "Enable Verbose Logging",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "startRecording",
   "name": "Start Recording",
   "options": [
    {
     "id": "all",
     "label": "All Channels",
     "type": "boolean",
     "default": false
    },
    {
     "id": "channel",
     "label": "Channel",
     "type": "select",
     "default": "1",
     "choices": [
      {
       "id": "1",
       "label": "Channel 1"
      },
      {
       "id": "2",
       "label": "Channel 2"
      },
      {
       "id": "3",
       "label": "Channel 3"
      },
      {
       "id": "4",
       "label": "Channel 4"
      }
     ]
    },
    {
     "id": "specify",
     "label": "Specify Filename",
     "type": "boolean",
     "default": false
    },
    {
     "id": "filename",
     "label": "Filename",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/ingest/startRecordingWithFilename",
    "body": "{\"channel\":{{option.channel|map}},\"proposed-filename\":\"{{option.specify|map}},\"toa-just-in-engine-alternative-start-timecode-active\":0}}",
    "contentType": "application/json"
   },
   "maps": {
    "channel": {
     "1": "1",
     "2": "2",
     "3": "3",
     "4": "4"
    },
    "specify": {
     "false": "\",\"metadata\":{\"toa-just-in-engine-alternative-start-timecode-frames\":0,\"tal-ingest-engine-override-naming-preset\":0",
     "true": "QB3x\",\"metadata\":{\"toa-just-in-engine-alternative-start-timecode-frames\":0,\"tal-ingest-engine-override-naming-preset\":1"
    }
   }
  },
  {
   "id": "stopRecording",
   "name": "Stop Recording",
   "options": [
    {
     "id": "all",
     "label": "All Channels",
     "type": "boolean",
     "default": false
    },
    {
     "id": "channel",
     "label": "Channel",
     "type": "select",
     "default": "1",
     "choices": [
      {
       "id": "1",
       "label": "Channel 1"
      },
      {
       "id": "2",
       "label": "Channel 2"
      },
      {
       "id": "3",
       "label": "Channel 3"
      },
      {
       "id": "4",
       "label": "Channel 4"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/ingest/stopRecording",
    "body": "{\"channel\":{{option.channel|map}},\"metadata\":{\"toa-just-in-engine-alternative-stop-timecode-active\":0,\"toa-just-in-engine-alternative-stop-timecode-frames\":0}}",
    "contentType": "application/json"
   },
   "maps": {
    "channel": {
     "1": "1",
     "2": "2",
     "3": "3",
     "4": "4"
    }
   }
  },
  {
   "id": "splitMovie",
   "name": "Split Movie",
   "options": [
    {
     "id": "all",
     "label": "All Channels",
     "type": "boolean",
     "default": false
    },
    {
     "id": "channel",
     "label": "Channel",
     "type": "select",
     "default": "1",
     "choices": [
      {
       "id": "1",
       "label": "Channel 1"
      },
      {
       "id": "2",
       "label": "Channel 2"
      },
      {
       "id": "3",
       "label": "Channel 3"
      },
      {
       "id": "4",
       "label": "Channel 4"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/ingest/splitMovie",
    "body": "{\"channel\":{{option.channel|map}}}",
    "contentType": "application/json"
   },
   "maps": {
    "channel": {
     "1": "1",
     "2": "2",
     "3": "3",
     "4": "4"
    }
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/bitfocus/companion-module-toolsonair-justincapture",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：Christian Schabasser, Joseph Adams"
  }
 ],
 "source": {
