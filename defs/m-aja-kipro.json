{
 "format": 1,
 "id": "m-aja-kipro",
 "name": "AJA Ki Pro / Ki Pro Ultra",
 "category": "AJA",
 "version": "3.4.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "polling",
   "label": "Polling",
   "type": "boolean",
   "default": true
  },
  {
   "id": "pollingRate",
   "label": "Polling Rate (ms)",
   "type": "number",
   "default": 100,
   "min": 10,
   "max": 5000
  },
  {
   "id": "password",
   "label": "Password",
   "type": "text",
   "default": ""
  },
  {
   "id": "verbose",
   "label": "Enable Verbose Logging",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "play",
   "name": "Play",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_TransportCommand&value=1"
   }
  },
  {
   "id": "stop",
   "name": "Stop",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_TransportCommand&value=4"
   }
  },
  {
   "id": "rec",
   "name": "Record",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_TransportCommand&value=3"
   }
  },
  {
   "id": "next",
   "name": "Next Clip",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_TransportCommand&value=9"
   }
  },
  {
   "id": "prv",
   "name": "Previous Clip",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_TransportCommand&value=10"
   }
  },
  {
   "id": "ff",
   "name": "Fast Forward",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_TransportCommand&value=5"
   }
  },
  {
   "id": "rev",
   "name": "Fast Reverse",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_TransportCommand&value=6"
   }
  },
  {
   "id": "stepF",
   "name": "Step Forward",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_TransportCommand&value=7"
   }
  },
  {
   "id": "stepB",
   "name": "Step Back",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_TransportCommand&value=8"
   }
  },
  {
   "id": "format",
   "name": "Format Drive",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_StorageCommand&value=4&configid=0"
   }
  },
  {
   "id": "formatUSB",
   "name": "Format USB Drive (Ki Pro Go)",
   "options": [
    {
     "id": "value",
     "label": "Drive",
     "type": "select",
     "default": "5",
     "choices": [
      {
       "id": "5",
       "label": "USB 1"
      },
      {
       "id": "6",
       "label": "USB 2"
      },
      {
       "id": "7",
       "label": "USB 3"
      },
      {
       "id": "8",
       "label": "USB 4"
      },
      {
       "id": "9",
       "label": "USB 5"
      },
      {
       "id": "10",
       "label": "All "
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_StorageCommand&value={{option.value|map}}&configid=1"
   },
   "maps": {
    "value": {
     "5": "5",
     "6": "6",
     "7": "7",
     "8": "8",
     "9": "9",
     "10": "10"
    }
   }
  },
  {
   "id": "eraseClip",
   "name": "Erase Clip By Name",
   "options": [
    {
     "id": "idx",
     "label": "Clip Name",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_ClipToDelete&value={{option.idx}}&configid=0"
   }
  },
  {
   "id": "eraseClipByDrop",
   "name": "Erase Clip By List",
   "options": [
    {
     "id": "idx",
     "label": "Clip Name",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/json?action=connect&configid=0"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/config?action=set&paramid=eParamID_ClipToDelete&value=&configid=0"
    }
   ]
  },
  {
   "id": "customTake",
   "name": "Set Custom Take Number",
   "options": [
    {
     "id": "idx",
     "label": "Take Name",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 999
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_CustomTake&value={{option.idx}}&configid=0"
   }
  },
  {
   "id": "customClipName",
   "name": "Set Custom Clip Name",
   "options": [
    {
     "id": "clipname",
     "label": "Clip Name",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_UseCustomClipName&value=1"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/config?action=set&paramid=eParamID_CustomClipName&value={{option.clipname}}"
    }
   ]
  },
  {
   "id": "customClipNameByChannel",
   "name": "Set Channel x Custom Clip Name (Ki Pro Go)",
   "options": [
    {
     "id": "channel",
     "label": "Channel Number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 4
    },
    {
     "id": "clipname",
     "label": "Clip Name",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_Channel_{{option.channel}}_Clipname&value={{option.clipname}}"
   }
  },
  {
   "id": "load",
   "name": "Load Clip By Name",
   "options": [
    {
     "id": "idx",
     "label": "Clip Name",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_GoToClip&value={{option.idx}}"
   }
  },
  {
   "id": "loadByDrop",
   "name": "Load Clip By List",
   "options": [
    {
     "id": "idx",
     "label": "Clip Name",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_GoToClip&value="
   }
  },
  {
   "id": "loop",
   "name": "Loop Clip",
   "options": [
    {
     "id": "idx",
     "label": "On / Off",
     "type": "select",
     "choices": [
      {
       "id": "0",
       "label": "Loop Off"
      },
      {
       "id": "1",
       "label": "Loop On"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_LoopPlay&value={{option.idx|map}}"
   },
   "maps": {
    "idx": {
     "0": "0",
     "1": "1"
    }
   }
  },
  {
   "id": "setMediaState",
   "name": "Set Media State",
   "options": [
    {
     "id": "idx",
     "label": "State",
     "type": "select",
     "choices": [
      {
       "id": "0",
       "label": "Play/Record"
      },
      {
       "id": "1",
       "label": "LAN"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/config?action=set&paramid=eParamID_MediaState&value={{option.idx|map}}"
   },
   "maps": {
    "idx": {
     "0": "0",
     "1": "1"
    }
   }
  }
 ],
