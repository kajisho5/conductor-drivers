{
 "format": 1,
 "id": "m-shure-scm820",
 "name": "Shure SCM820",
 "category": "Shure",
 "version": "2.2.0",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 2202,
   "min": 1,
   "max": 65535
  },
  {
   "id": "meteringOn",
   "label": "Enable Metering?",
   "type": "boolean",
   "default": true
  },
  {
   "id": "meteringInterval",
   "label": "Metering Interval (in ms)",
   "type": "number",
   "default": 1000,
   "min": 250,
   "max": 99999
  },
  {
   "id": "variableFormat",
   "label": "Variable Format",
   "type": "select",
   "default": "units",
   "choices": [
    {
     "id": "units",
     "label": "Include Units"
    },
    {
     "id": "numeric",
     "label": "Numeric Only"
    }
   ],
   "help": "Changing this setting will apply to new values received.  To refresh all variables with the new setting, disable and re-enable the connection after saving these settings."
  }
 ],
