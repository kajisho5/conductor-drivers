{
 "format": 1,
 "id": "m-adder-infinity-alif",
 "name": "Adder ALIF",
 "category": "Adder",
 "version": "1.0.0-beta1",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "https://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "password",
   "label": "Password",
   "type": "text",
   "default": ""
  }
 ],
 "actions": [
  {
   "id": "refresh_presets",
   "name": "Refresh Presets",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/presets"
   }
  },
  {
   "id": "change_preset",
   "name": "Change Preset",
   "options": [
    {
     "id": "preset",
     "label": "Preset",
     "type": "select",
     "default": "None",
     "choices": [
      {
       "id": "None",
       "label": "None"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/users/login/1",
    "body": "{\"password\":\"\",\"isAdmin\":true}",
    "contentType": "application/json"
   },
   "more": [
    {
     "kind": "http",
     "method": "POST",
     "path": "/api/users/login/1",
     "body": "{\"password\":\"\",\"isAdmin\":true}",
     "contentType": "application/json"
    },
    {
     "kind": "http",
     "method": "PATCH",
     "path": "/api/presets/selected",
     "body": "{\"presetId\":\"None\",\"accessMode\":1}",
     "contentType": "application/json"
    }
   ]
  },
  {
   "id": "disconnect",
   "name": "Disconnect",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/users/login/1",
    "body": "{\"password\":\"\",\"isAdmin\":true}",
    "contentType": "application/json"
   },
   "more": [
    {
     "kind": "http",
     "method": "PATCH",
     "path": "/api/presets/selected",
     "body": "{\"presetId\":0,\"accessMode\":\"shared\"}",
     "contentType": "application/json"
    }
   ]
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
