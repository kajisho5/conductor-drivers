{
 "format": 1,
 "id": "m-odyssey-insight",
 "name": "Odyssey Development Insight",
 "category": "Odyssey Development",
 "version": "1.0.1",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 36279,
   "min": 1,
   "max": 65535
  },
  {
   "id": "authToken",
   "label": "Authorization Key",
   "type": "text",
   "default": ""
  },
  {
   "id": "channelID",
   "label": "Channel",
   "type": "number",
   "default": 1,
   "min": 1,
   "max": 12
  },
  {
   "id": "refreshPeriod",
   "label": "Status refresh period",
   "type": "number",
   "default": 500,
   "min": 100,
   "max": 2000
  }
 ],
