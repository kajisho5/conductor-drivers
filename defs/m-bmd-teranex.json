{
 "format": 1,
 "id": "m-bmd-teranex",
 "name": "Blackmagic Design Teranex",
 "category": "Blackmagic Design",
 "version": "2.3.2",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 9800,
   "min": 1,
   "max": 65535
  },
  {
   "id": "debug",
   "label": "Enable Debug",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "set_input",
   "name": "Set video input",
   "options": [
    {
     "id": "source",
     "label": "Source",
     "type": "select",
     "default": "SDI1",
     "choices": [
      {
       "id": "SDI",
       "label": "SDI (2D, 3D, Express)"
      },
      {
       "id": "SDI1",
       "label": "SDI 1 (AV)"
      },
      {
       "id": "SDI2",
       "label": "SDI 2 (AV)"
      },
      {
       "id": "HDMI",
       "label": "HDMI (2D, 3D, AV)"
      },
      {
       "id": "Composite",
       "label": "Composite (2D, 3D)"
      },
      {
       "id": "Component",
       "label": "Component (2D, 3D)"
      },
      {
       "id": "Optical",
       "label": "Optical (Express, AV)"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "VIDEO INPUT:\\nVideo source:{{option.source|map}}\\n\\n",
    "encoding": "text"
   },
   "maps": {
    "source": {
     "SDI1": "SDI1",
     "SDI": "SDI",
     "SDI2": "SDI2",
     "HDMI": "HDMI",
     "Composite": "Composite",
     "Component": "Component",
     "Optical": "Optical"
    }
   }
  },
  {
   "id": "set_audio",
   "name": "Set audio input",
   "options": [
    {
     "id": "source",
     "label": "Source",
     "type": "select",
     "default": "Embedded",
     "choices": [
      {
       "id": "Embedded",
       "label": "Embedded (2D, 3D, Express, AV)"
      },
      {
       "id": "AES",
       "label": "AES (2D, 3D, AV)"
      },
      {
       "id": "RCA",
       "label": "RCA (2D, 3D, AV)"
      },
      {
       "id": "DB25",
       "label": "DB25 (2D, 3D, AV))"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "VIDEO INPUT:\\nAudio source: {{option.source|map}}\\n\\n",
    "encoding": "text"
   },
   "maps": {
    "source": {
     "Embedded": "Embedded",
     "AES": "AES",
     "RCA": "RCA",
     "DB25": "DB25"
    }
   }
  },
  {
   "id": "noisereduction_enabled",
   "name": "Noise Reduction - Enable Noise Reduction",
   "options": [],
