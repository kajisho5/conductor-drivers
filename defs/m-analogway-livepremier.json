 "category": "Analog Way",
 "version": "2.0.1",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  }
 ],
 "actions": [
  {
   "id": "/api/tpp/v1/screens/{screenId}/load-memory",
   "name": "Recall Memory to Screen",
   "options": [
    {
     "id": "memoryId",
     "label": "Memory",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 1000
    },
    {
     "id": "screenId",
     "label": "Screen",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 24
    },
    {
     "id": "target",
     "label": "Recall to",
     "type": "select",
     "default": "preview",
     "choices": [
      {
       "id": "preview",
       "label": "Preview"
      },
      {
       "id": "program",
       "label": "Program"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/tpp/v1/screens/{{option.screenId}}/load-memory",
    "body": "{\"memoryId\":{{option.memoryId}},\"target\":\"pr{{option.target|map}}\"}",
    "contentType": "application/json"
   },
   "maps": {
    "target": {
     "preview": "eview",
     "program": "ogram"
    }
   }
  },
