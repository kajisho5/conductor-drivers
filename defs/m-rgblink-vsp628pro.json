{
 "format": 1,
 "id": "m-rgblink-vsp628pro",
 "name": "RGBlink VSP 628pro",
 "category": "RGBlink",
 "version": "1.0.1",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "help": "機器の説明書にあるポート番号を入れてください",
   "min": 1,
   "max": 65535
  },
  {
   "id": "polling",
   "label": "Status polling (ask for status every second)",
   "type": "boolean",
   "default": true
  },
  {
   "id": "logEveryCommand",
   "label": "Debug logging of every sent/received command (may slow down your computer)",
   "type": "boolean",
   "default": false,
   "help": "test toolitp"
  }
 ],
 "actions": [
  {
   "id": "set_system_mode",
   "name": "Set system mode (standard/pip/dual 2k/switcher...)",
   "options": [
    {
     "id": "mode",
     "label": "System mode",
     "type": "select",
     "default": "16",
     "choices": [
      {
       "id": "11",
       "label": "PIP"
      },
      {
       "id": "15",
       "label": "Dual 2K"
      },
      {
       "id": "16",
       "label": "Standard"
      },
      {
       "id": "17",
       "label": "Switcher"
      },
      {
       "id": "19",
       "label": "Split"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "<T008{{option.mode|map}}>",
    "encoding": "text"
   },
   "maps": {
    "mode": {
     "11": "A6B0001110007",
     "15": "B6B000115000C",
     "16": "96B000016000A",
     "17": "C6B000017000E",
     "19": "D6B0000190011"
    }
   }
  },
  {
   "id": "set_freeze_status",
   "name": "Set freeze/live",
   "options": [
    {
     "id": "status",
     "label": "Status",
     "type": "select",
     "default": "01",
     "choices": [
      {
       "id": "00",
       "label": "Live"
      },
      {
       "id": "01",
       "label": "Freeze"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "<T008{{option.status|map}}0005>",
    "encoding": "text"
   },
   "maps": {
    "status": {
     "01": "E75000101",
     "00": "F75000100"
    }
   }
  },
  {
   "id": "set_layer",
   "name": "Set layer",
   "options": [
    {
     "id": "layer",
     "label": "Layer",
     "type": "select",
     "default": "00",
     "choices": [
      {
       "id": "00",
       "label": "Layer A"
      },
      {
       "id": "01",
       "label": "Layer B"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "<T00C{{option.layer|map}}>",
    "encoding": "text"
   },
   "maps": {
    "layer": {
     "00": "86B0200000035",
     "01": "96B0201000037"
    }
   }
  },
  {
   "id": "lock",
   "name": "Lock front panel",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "<T00CA680201000035>",
    "encoding": "text"
   }
  },
  {
