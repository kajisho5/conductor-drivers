{
 "format": 1,
 "id": "m-iccms-sib",
 "name": "IC Control Media & Sport AB Sport In The Box",
 "category": "IC Control Media & Sport AB",
 "version": "1.0.2",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:8080",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "sib_ip_port",
   "label": "Sport In The Box api port",
   "type": "text",
   "default": "8080",
   "help": "Default is 8080"
  },
  {
   "id": "sib_ip_pass",
   "label": "API Password",
   "type": "text",
   "help": "Same password as in General settings - API"
  },
  {
   "id": "sib_helper_pass",
   "label": "Helper Password",
   "type": "text",
   "help": "Password from service helper in tray menu."
  },
  {
   "id": "reconnect",
   "label": "Reconnect",
   "type": "boolean",
   "default": true,
   "help": "Reconnect on error"
  },
  {
   "id": "debug_messages",
   "label": "Debug messages",
   "type": "boolean",
   "default": false,
   "help": "Log incoming and outgoing messages"
  },
  {
   "id": "reset_variables",
   "label": "Reset variables",
   "type": "boolean",
   "default": false,
   "help": "Reset variables on init and on connect"
  }
 ],
 "actions": [
  {
   "id": "sib_action_trigger_event",
   "name": "Fire QuickButton",
   "options": [
    {
     "id": "sib_action_trigger_event",
     "label": "TriggerID",
     "type": "text",
     "default": "-1"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/quickbutton/trig/-1"
   }
  },
  {
   "id": "sib_action_change_team",
   "name": "Change team",
   "options": [
    {
     "id": "team_type",
     "label": "Team to change",
     "type": "select",
     "default": "h",
     "choices": [
      {
       "id": "h",
       "label": "Home"
      },
      {
       "id": "g",
       "label": "Guest"
      }
     ],
     "help": "Which team to change?"
    },
    {
     "id": "team_oid",
     "label": "Select team",
     "type": "select",
     "default": "-1",
     "choices": [
      {
       "id": "-1",
       "label": "No team"
      }
     ],
     "help": "Change match home or guest team."
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/match//team/{{option.team_type|map}}/-1/"
   },
   "maps": {
    "team_type": {
     "h": "h",
     "g": "g"
    }
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/bitfocus/companion-module-iccms-sib",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：Dmitrii Peredera"
  }
 ],
 "source": {
  "module": "iccms-sib",
  "version": "1.0.2",
  "license": "MIT",
  "maintainers": [
   "Dmitrii Peredera"
  ],
  "repository": "git+https://github.com/bitfocus/companion-module-iccms-sib.git"
 }
}
