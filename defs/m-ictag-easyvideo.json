{
 "format": 1,
 "id": "m-ictag-easyvideo",
 "name": "ICT AG easyVideo",
 "category": "ICT AG",
 "version": "1.1.0",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 0,
   "min": 1,
   "max": 65535
  },
  {
   "id": "feedbackEnabled",
   "label": "Enable Feedback",
   "type": "boolean"
  },
  {
   "id": "infoPort",
   "label": "Info Port",
   "type": "text",
   "help": "Default Port is 4334"
  }
 ],
 "actions": [
  {
   "id": "pause",
   "name": "Pause/Play",
   "options": [],
   "send": {
    "kind": "osc",
    "address": "/ict_ev/pause",
    "args": []
   }
  },
  {
   "id": "stop",
   "name": "Stop",
   "options": [],
   "send": {
    "kind": "osc",
    "address": "/ict_ev/stop",
    "args": []
   }
  },
  {
   "id": "next",
   "name": "Next Clip",
   "options": [],
   "send": {
    "kind": "osc",
    "address": "/ict_ev/next",
    "args": []
   }
  },
  {
   "id": "prev",
   "name": "Previous Clip",
   "options": [],
   "send": {
    "kind": "osc",
    "address": "/ict_ev/prev",
    "args": []
   }
  },
  {
   "id": "loadFolder",
   "name": "Load Media Folder",
   "options": [
    {
     "id": "folderPath",
     "label": "Folder path",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "osc",
    "address": "/ict_ev/loadFolder",
    "args": [
     {
      "type": "s",
      "value": "{{option.folderPath}}"
     }
    ]
   }
  },
  {
   "id": "overlay",
   "name": "Overlay",
   "options": [
    {
     "id": "overlay",
     "label": "State",
     "type": "select",
     "default": "1",
     "choices": [
      {
       "id": "1",
       "label": "Off"
      },
      {
       "id": "2",
       "label": "On"
      },
      {
       "id": "3",
       "label": "Toggle"
      }
     ]
    }
   ],
   "send": {
    "kind": "osc",
    "address": "/ict_ev/overlay",
    "args": [
     {
      "type": "i",
      "value": "{{option.overlay|map}}"
     }
    ]
   },
   "maps": {
    "overlay": {
     "1": "0",
     "2": "1",
     "3": "2"
    }
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "presets": [
  {
   "id": "Pause",
   "category": "Controls and Feedbacks",
   "name": "Pause",
   "text": "⏯",
   "backgroundColor": "#000000",
   "action": {
    "definitionId": "pause",
    "options": {}
   }
  },
  {
   "id": "Stop",
   "category": "Controls and Feedbacks",
   "name": "Stop",
   "text": "⏹",
   "backgroundColor": "#000000",
   "action": {
    "definitionId": "stop",
    "options": {}
   }
  },
  {
   "id": "Prev",
   "category": "Controls and Feedbacks",
   "name": "Prev",
   "text": "⏮",
   "backgroundColor": "#000000",
   "action": {
    "definitionId": "prev",
    "options": {}
   }
  },
  {
   "id": "Next",
   "category": "Controls and Feedbacks",
   "name": "Next",
   "text": "⏭",
   "backgroundColor": "#000000",
   "action": {
    "definitionId": "next",
    "options": {}
   }
  },
  {
   "id": "Overlay_on",
   "category": "Overlay",
   "name": "On",
   "text": "PiP\nOn",
   "backgroundColor": "#0033cc",
   "action": {
    "definitionId": "overlay",
    "options": {
     "overlay": "2"
    }
   }
  },
  {
   "id": "Overlay_off",
   "category": "Overlay",
   "name": "Off",
   "text": "PiP\nOff",
   "backgroundColor": "#0033cc",
   "action": {
    "definitionId": "overlay",
    "options": {
     "overlay": "1"
    }
   }
  },
  {
   "id": "Overlay_toggle",
   "category": "Overlay",
   "name": "Toggle",
   "text": "PiP\nToggle",
   "backgroundColor": "#0033cc",
   "action": {
    "definitionId": "overlay",
    "options": {
     "overlay": "3"
    }
   }
  }
 ],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/bitfocus/companion-module-ictag-easyvideo",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：digitalMIDIA"
  }
 ],
