{
 "format": 1,
 "id": "m-nanoleaf-shapes",
 "name": "Nanoleaf Shapes / Aurora / Canvas / Elements",
 "category": "Nanoleaf",
 "version": "1.0.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:16021",
   "placeholder": "http://192.168.0.10",
   "mono": true
  }
 ],
 "actions": [
  {
   "id": "turnOn",
   "name": "Turn on",
   "options": [],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"on\":{\"value\":true}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "turnOff",
   "name": "Turn off",
   "options": [],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"on\":{\"value\":false}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "setSaturation",
   "name": "Set Saturation",
   "options": [
    {
     "id": "saturation",
     "label": "Saturation",
     "type": "number",
     "default": 10,
     "min": 0,
     "max": 100
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"sat\":{\"value\":{{option.saturation}}}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "changeSaturation",
   "name": "Change Saturation",
   "options": [
    {
     "id": "saturation",
     "label": "Change saturation by",
     "type": "number",
     "default": 10,
     "min": -100,
     "max": 100
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"sat\":{\"increment\":{{option.saturation}}}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "setBrightness",
   "name": "Set Brightness",
   "options": [
    {
     "id": "brightness",
     "label": "Brightness",
     "type": "number",
     "default": 10,
     "min": 0,
     "max": 100
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"brightness\":{\"value\":{{option.brightness}}}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "changeBrightness",
   "name": "Change Brightness",
   "options": [
    {
     "id": "brightness",
     "label": "Change Brightness by",
     "type": "number",
     "default": 10,
     "min": -100,
     "max": 100
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"brightness\":{\"increment\":{{option.brightness}}}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "setDurationBrightness",
   "name": "Fade to Brightness",
   "options": [
    {
     "id": "brightness",
     "label": "Brightness",
     "type": "number",
     "default": 10,
     "min": 0,
     "max": 100
    },
    {
     "id": "duration",
     "label": "Duration",
     "type": "number",
     "default": 10,
     "min": 0
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"brightness\":{\"value\":{{option.brightness}},\"duration\":{{option.duration}}}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "setHue",
   "name": "Set Hue",
   "options": [
    {
     "id": "hue",
     "label": "Hue",
     "type": "number",
     "default": 10,
     "min": 0,
     "max": 360
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"hue\":{\"value\":{{option.hue}}}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "changeHue",
   "name": "Change Hue",
   "options": [
    {
     "id": "hue",
     "label": "Change Hue by",
     "type": "number",
     "default": 10,
     "min": -360,
     "max": 360
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"hue\":{\"increment\":{{option.hue}}}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "setColorTemperature",
   "name": "Set Color Temperature",
   "options": [
    {
     "id": "temperature",
     "label": "Color Temperature",
     "type": "number",
     "default": 3850,
     "min": 1200,
     "max": 6500
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"ct\":{\"value\":{{option.temperature}}}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "changeColorTemperature",
   "name": "Change Color Temperature",
   "options": [
    {
     "id": "temperature",
     "label": "Change Color Temperature by",
     "type": "number",
     "default": 10,
     "min": -5000,
     "max": 5000
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"ct\":{\"increment\":{{option.temperature}}}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "setEffect",
   "name": "Set Effect",
   "options": [
    {
     "id": "effect",
     "label": "Effect",
     "type": "select",
     "default": "x",
     "choices": [
      {
       "id": "x",
       "label": "** Connection failed **"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/effects",
    "body": "{\"select\":\"x\"}",
    "contentType": "application/json"
   }
  },
  {
   "id": "setColorPicker",
   "name": "Set Color (using color picker)",
   "options": [],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"hue\":{\"value\":60}}",
    "contentType": "application/json"
   },
   "more": [
    {
     "kind": "http",
     "method": "PUT",
     "path": "/api/v1/state",
     "body": "{\"sat\":{\"value\":100}}",
     "contentType": "application/json"
    },
    {
     "kind": "http",
     "method": "PUT",
     "path": "/api/v1/state",
     "body": "{\"brightness\":{\"value\":100}}",
     "contentType": "application/json"
    }
   ]
  },
  {
   "id": "setHsvColor",
   "name": "Set HSV Color",
   "options": [
    {
     "id": "hue",
     "label": "Hue",
     "type": "number",
     "default": 120,
     "min": 0,
     "max": 360
    },
    {
     "id": "saturation",
     "label": "Saturation",
     "type": "number",
     "default": 100,
     "min": 0,
     "max": 100
    },
    {
     "id": "value",
     "label": "Value",
     "type": "number",
     "default": 100,
     "min": 0,
     "max": 100
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"hue\":{\"value\":{{option.hue}}}}",
    "contentType": "application/json"
   },
   "more": [
    {
     "kind": "http",
     "method": "PUT",
     "path": "/api/v1/state",
     "body": "{\"sat\":{\"value\":{{option.saturation}}}}",
     "contentType": "application/json"
    },
    {
     "kind": "http",
     "method": "PUT",
     "path": "/api/v1/state",
     "body": "{\"brightness\":{\"value\":{{option.value}}}}",
     "contentType": "application/json"
    }
   ]
  },
  {
   "id": "setHslColor",
   "name": "Set HSL Color",
   "options": [
    {
     "id": "hue",
     "label": "Hue",
     "type": "number",
     "default": 120,
     "min": 0,
     "max": 359
    },
    {
     "id": "saturation",
     "label": "Saturation",
     "type": "number",
     "default": 100,
     "min": 0,
     "max": 100
    },
    {
     "id": "lightness",
     "label": "Lightness",
     "type": "number",
     "default": 100,
     "min": 0,
     "max": 100
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/api/v1/state",
    "body": "{\"hue\":{\"value\":{{option.hue}}}}",
    "contentType": "application/json"
   },
   "more": [
    {
     "kind": "http",
     "method": "PUT",
     "path": "/api/v1/state",
     "body": "{\"sat\":{\"value\":{{option.saturation}}}}",
     "contentType": "application/json"
    },
    {
     "kind": "http",
     "method": "PUT",
     "path": "/api/v1/state",
     "body": "{\"brightness\":{\"value\":{{option.lightness}}}}",
     "contentType": "application/json"
    }
   ]
  }
 ],
