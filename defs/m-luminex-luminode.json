{
 "format": 1,
 "id": "m-luminex-luminode",
 "name": "Luminex LumiNode / LumiCore",
 "category": "Luminex",
 "version": "1.1.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "password",
   "label": "Password",
   "type": "text",
   "help": "Only provide a password when authentication is enabled on the device"
  }
 ],
 "actions": [
  {
   "id": "identify",
   "name": "Identify",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/api/identify"
   }
  },
  {
   "id": "reboot",
   "name": "Reboot",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/reboot",
    "body": "",
    "contentType": "application/json"
   }
  },
  {
   "id": "reset",
   "name": "Reset",
   "options": [
    {
     "id": "keep_ip_settings",
     "label": "Keep IP Settings",
     "type": "boolean",
     "default": true
    },
    {
     "id": "keep_user_profiles",
     "label": "Keep User Profiles",
     "type": "boolean",
     "default": true
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/reset",
    "body": "{\"keep_ip_settings\":{{option.keep_ip_settings|map}}e,\"keep_user_profiles\":{{option.keep_user_profiles|map}}e}",
    "contentType": "application/json"
   },
   "maps": {
    "keep_ip_settings": {
     "true": "tru",
     "false": "fals"
    },
    "keep_user_profiles": {
     "true": "tru",
     "false": "fals"
    }
   }
  },
  {
   "id": "display_on",
   "name": "Turn on or off the display",
   "options": [
    {
     "id": "display_on",
     "label": "Display On",
     "type": "boolean",
     "default": true
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/display",
    "body": "{\"display_on\":{{option.display_on|map}}e}",
    "contentType": "application/json"
   },
   "maps": {
    "display_on": {
     "true": "tru",
     "false": "fals"
    }
   }
  },
  {
   "id": "recall_profile",
   "name": "Recall configuration from profile",
   "options": [
    {
     "id": "profile",
     "label": "Profile",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 40,
     "help": "1-based profile number"
    },
    {
     "id": "keep_ip_settings",
     "label": "Keep Ip Settings",
     "type": "boolean",
     "default": true
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/profile/{{option.profile|lin:1:-1}}/recall",
    "body": "{\"keep_ip_settings\":{{option.keep_ip_settings|map}}e}",
    "contentType": "application/json"
   },
   "maps": {
    "keep_ip_settings": {
     "true": "tru",
     "false": "fals"
    }
   }
  },
  {
   "id": "save_profile",
   "name": "Save current configuration to profile",
   "options": [
    {
     "id": "profile",
     "label": "Profile number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 40,
     "help": "1-based profile number"
    },
    {
     "id": "name",
     "label": "Profile name",
     "type": "text",
     "default": "Profile",
     "help": "The name that the new profile should get"
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/profile/{{option.profile|lin:1:-1}}/save",
    "body": "{\"name\":\"{{option.name}}\"}",
    "contentType": "application/json"
   }
  },
  {
   "id": "dmx_acknowledge",
   "name": "Acknowledge all stream loss indications",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/dmx/acknowledge",
    "body": "",
    "contentType": "application/json"
   }
  },
  {
   "id": "dmx_acknowledge_port",
   "name": "Acknowledge stream loss indications for the given port",
   "options": [
    {
     "id": "port",
     "label": "Port",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 12,
     "help": "1-based DMX port number"
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/dmx/{{option.port|lin:1:-1}}/acknowledge",
    "body": "",
    "contentType": "application/json"
   }
  },
  {
   "id": "force_rdm_discovery",
   "name": "Force RDM discovery for all DMX ports",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/dmx/force_discovery",
    "body": "",
    "contentType": "application/json"
   }
  },
  {
   "id": "force_rdm_discovery_port",
   "name": "Force RDM discovery for the given port",
   "options": [
    {
     "id": "port",
     "label": "Port",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 12,
     "help": "1-based DMX port number"
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/dmx/{{option.port|lin:1:-1}}/force_discovery",
    "body": "",
    "contentType": "application/json"
   }
  },
  {
   "id": "play_control",
   "name": "Control all players",
   "options": [
    {
     "id": "action",
     "label": "Action",
     "type": "select",
     "default": "go",
     "choices": [
      {
       "id": "go",
       "label": "Go"
      },
      {
       "id": "forward",
       "label": "Forward"
      },
      {
       "id": "back",
       "label": "Back"
      },
      {
       "id": "reset",
       "label": "Reset"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/play/control",
    "body": "{\"action\":\"{{option.action|map}}\"}",
    "contentType": "application/json"
   },
   "maps": {
    "action": {
     "go": "go",
     "forward": "forward",
     "back": "back",
     "reset": "reset"
    }
   }
  },
  {
   "id": "play_snapshot",
   "name": "Play a specific snapshot",
   "options": [
    {
     "id": "snapshot_id",
     "label": "Snapshot ID",
     "type": "text",
     "default": "1.00"
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/play/play_snapshot",
    "body": "{\"snapshot_id\":\"{{option.snapshot_id}}\"}",
    "contentType": "application/json"
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "presets": [
  {
   "id": "active_profile",
   "category": "Profiles",
   "name": "Active Profile Name\nEmpty if no profile active",
   "text": "Active Profile Name\nEmpty if no profile ",
   "backgroundColor": "#000000",
   "action": {
    "definitionId": "identify",
    "options": {}
