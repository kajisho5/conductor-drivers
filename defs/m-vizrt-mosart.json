{
 "format": 1,
 "id": "m-vizrt-mosart",
 "name": "Vizrt Mosart",
 "category": "Vizrt",
 "version": "1.0.5",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:55142",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "useWebApi",
   "label": "Use Web API",
   "type": "boolean",
   "default": true
  },
  {
   "id": "apiKey",
   "label": "API Key",
   "type": "text"
  }
 ],
 "actions": [
  {
   "id": "reload",
   "name": "Reload rundown",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/mosart/api/v1/command/reload"
   }
  },
  {
   "id": "start_continue",
   "name": "Start/Continue the rundown",
   "options": [
    {
     "id": "option",
     "label": "Option",
     "type": "select",
     "default": "Default",
     "choices": [
      {
       "id": "Default",
       "label": "Default"
      },
      {
       "id": "Continue",
       "label": "Continue"
      },
      {
       "id": "Mix",
       "label": "Mix"
      },
      {
       "id": "Wipe",
       "label": "Wipe"
      },
      {
       "id": "Effect",
       "label": "Effect"
      }
     ]
    },
    {
     "id": "rate",
     "label": "Rate",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 1000000,
     "help": "The transition rate for mix/wipe"
    },
    {
     "id": "effect",
     "label": "Effect",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 100,
     "help": "The effect number"
    },
    {
     "id": "delay",
     "label": "Delay",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 1000000,
     "help": "The delay in milliseconds for continue"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/mosart/api/v1/command/start-continue?option={{option.option|map}}&rate={{option.rate}}&effect={{option.effect}}&delay={{option.delay}}"
   },
   "maps": {
    "option": {
     "Default": "Default",
     "Continue": "Continue",
     "Mix": "Mix",
     "Wipe": "Wipe",
     "Effect": "Effect"
    }
   }
  },
