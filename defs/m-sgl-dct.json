{
 "format": 1,
 "id": "m-sgl-dct",
 "name": "SGL DCT",
 "category": "SGL",
 "version": "1.0.0",
 "minAppVersion": "0.6.0",
 "transport": "ws",
 "wsPath": "/",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 9001,
   "min": 1,
   "max": 65535
  },
  {
   "id": "unusedBufferText",
   "label": "Unused Buffer Text",
   "type": "text",
   "default": "DISABLED"
  },
  {
   "id": "setModes",
   "label": "Set Recording, Playback, and Stop Modes",
   "type": "boolean",
   "default": false
  },
  {
   "id": "recordingMode",
   "label": "Recording Mode",
   "type": "select",
   "default": "0",
   "choices": [
    {
     "id": "0",
     "label": "Loop"
    },
    {
     "id": "1",
     "label": "Once"
    }
   ]
  },
  {
   "id": "playbackMode",
   "label": "Playback Mode",
   "type": "select",
   "default": "0",
   "choices": [
    {
     "id": "0",
     "label": "Loop"
    },
    {
     "id": "1",
     "label": "Once"
    }
   ]
  },
  {
   "id": "stopMode",
   "label": "Stop Mode",
   "type": "select",
   "default": "0",
   "choices": [
    {
     "id": "0",
     "label": "Live"
    },
    {
     "id": "1",
     "label": "Black"
    },
    {
     "id": "2",
     "label": "Color Bars"
    }
   ]
  },
  {
   "id": "recordIntoEarliest",
   "label": "Record into Earliest Free Buffer upon Module Init",
   "type": "boolean",
   "default": false
  },
  {
   "id": "forceSequentialRecording",
   "label": "Force Sequential Recording - Does not allow recording into a buffer that is not ",
   "type": "boolean",
   "default": false
  },
  {
   "id": "polling",
   "label": "Enable Polling",
   "type": "boolean",
   "default": true
  },
  {
   "id": "rate",
   "label": "Polling Interval (ms)",
   "type": "number",
   "default": 1000,
   "min": 20,
   "max": 60000
  },
  {
   "id": "verbose",
   "label": "Verbose Logging",
   "type": "boolean"
  }
 ],
 "actions": [
  {
   "id": "pause",
   "name": "Pause",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "pause\\n",
    "encoding": "text"
   }
  },
  {
   "id": "stop",
   "name": "Stop",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "stop\\n",
    "encoding": "text"
   }
  },
  {
   "id": "changeRecordingMode",
   "name": "Change Recording Mode",
   "options": [
    {
     "id": "mode",
     "label": "Mode",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "0",
       "label": "Loop"
      },
      {
       "id": "1",
       "label": "Once"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "rec_mode {{option.mode|map}}\\n",
    "encoding": "text"
   },
   "maps": {
    "mode": {
     "0": "0",
     "1": "1"
    }
   }
  },
  {
   "id": "changePlaybackMode",
   "name": "Change Playback Mode",
   "options": [
    {
     "id": "mode",
     "label": "Mode",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "0",
       "label": "Loop"
      },
      {
       "id": "1",
       "label": "Once"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "play_mode {{option.mode|map}}\\n",
    "encoding": "text"
   },
   "maps": {
    "mode": {
     "0": "0",
     "1": "1"
    }
   }
  },
  {
   "id": "changeStopMode",
   "name": "Change Stop Mode",
   "options": [
    {
     "id": "mode",
     "label": "Mode",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "0",
       "label": "Live"
      },
      {
       "id": "1",
