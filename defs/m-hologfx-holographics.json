{
 "format": 1,
 "id": "m-hologfx-holographics",
 "name": "hologfx.io Holographics",
 "category": "hologfx.io",
 "version": "2.0.2",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:3000",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "polling",
   "label": "Enable Polling",
   "type": "boolean",
   "default": true
  },
  {
   "id": "polling_interval",
   "label": "Polling Interval (ms)",
   "type": "text",
   "default": "1000"
  },
  {
   "id": "reconnect",
   "label": "Auto Reconnect if Connection is Lost",
   "type": "boolean",
   "default": true
  },
  {
   "id": "reconnect_interval",
   "label": "Reconnect Interval (ms)",
   "type": "text",
   "default": "5000"
  },
  {
   "id": "verbose",
   "label": "Enable Verbose Logging",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "setTheme",
   "name": "Set active theme",
   "options": [
    {
     "id": "filename",
     "label": "Theme",
     "type": "select",
     "choices": [
      {
       "id": "null",
       "label": "No Themes Loaded"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/socket.io/?EIO=3&transport=polling&t=Q6zEznQ&b64=1"
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
