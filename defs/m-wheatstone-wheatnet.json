   ],
   "send": {
    "kind": "bytes",
    "data": "<UMIX:{{option.mixer|map}}.{{option.channel|map}}|FDR{{option.output|map}}:{{option.db}}>\\r\\n",
    "encoding": "text"
   },
   "maps": {
    "mixer": {
     "1": "1",
     "2": "2"
