{
 "format": 1,
 "id": "m-wheatstone-wheatnet",
 "name": "Wheatstone WheatNet IP",
 "category": "Wheatstone",
 "version": "1.0.1",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 55776,
   "min": 1,
   "max": 65535
  },
  {
   "id": "heartbeatInterval",
   "label": "Heartbeat interval (in seconds, 120 = maximum)",
   "type": "number",
   "default": 30,
   "min": 0,
   "max": 120
  },
  {
   "id": "debugLogging",
   "label": "Log extra info during connection operations, for debugging purposes",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "sys_set_ifid",
   "name": "System: Set IFID",
   "options": [
    {
     "id": "ifid",
     "label": "IFID String",
     "type": "text",
     "default": "Companion"
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "<SYS|IFID:{{option.ifid}}>\\r\\n",
    "encoding": "text"
   }
  },
  {
   "id": "sys_set_subrate",
   "name": "System: Set Subscription Rate",
   "options": [
    {
     "id": "capacity",
     "label": "Capacity",
     "type": "number",
     "default": 10,
     "min": 1,
     "max": 500
    },
    {
     "id": "rate",
     "label": "Rate (msg/s)",
     "type": "number",
     "default": 100,
     "min": 1,
     "max": 1000
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "<SYS|SUBRATE:{{option.capacity}}.{{option.rate}}>\\r\\n",
    "encoding": "text"
   }
  },
  {
   "id": "umix_input_fader",
   "name": "UMIX Input: Set Fader Output",
   "options": [
    {
     "id": "mixer",
     "label": "Mixer",
     "type": "select",
     "default": "1",
     "choices": [
      {
       "id": "1",
       "label": "1"
      },
      {
       "id": "2",
       "label": "2"
      }
     ]
    },
    {
     "id": "channel",
     "label": "Channel",
     "type": "select",
     "default": "1",
