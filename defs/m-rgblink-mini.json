{
 "format": 1,
 "id": "m-rgblink-mini",
 "name": "RGBlink mini/mini+",
 "category": "RGBlink",
 "version": "2.1.0",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 1000,
   "min": 1,
   "max": 65535
  },
  {
   "id": "polling",
   "label": "Status polling (requests status every second)",
   "type": "boolean",
   "default": true
  },
  {
   "id": "pollingEdge",
   "label": "EXPERIMENTAL: Status polling – extra for mini-edge (requests status every second",
   "type": "boolean",
   "default": false
  },
  {
   "id": "logEveryCommand",
   "label": "Debug logging of every sent/received command (may slow down your computer)",
   "type": "boolean",
   "default": false,
   "help": "test toolitp"
  }
 ],
 "actions": [
  {
   "id": "switch_to_source",
   "name": "Switch signal source",
   "options": [
    {
     "id": "sourceNumber",
     "label": "Source number",
     "type": "select",
     "default": "1",
     "choices": [
      {
       "id": "1",
       "label": "1"
      },
      {
       "id": "2",
       "label": "2"
      },
      {
       "id": "3",
