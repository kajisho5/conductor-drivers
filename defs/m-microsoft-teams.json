{
 "format": 1,
 "id": "m-microsoft-teams",
 "name": "Microsoft Teams",
 "category": "Microsoft",
 "version": "1.3.0",
 "minAppVersion": "0.6.0",
 "transport": "ws",
 "wsPath": "/?token=&protocol-version=2.0.0&manufacturer=Bitfocus&device=Companion&app=Companion-Microsoft%20Teams&app-version=1.0.2",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 8124,
   "min": 1,
   "max": 65535
  },
  {
   "id": "apiVersion",
   "label": "API Version",
   "type": "select",
   "default": "2.0.0",
   "choices": [
    {
     "id": "1.0.0",
     "label": "1.0.0, Microsoft Teams Classic"
    },
    {
     "id": "2.0.0",
     "label": "2.0.0, Microsoft Teams (For Work or School)"
    }
   ],
   "help": "Select the version of Teams to accommodate the differently supported APIs"
  },
  {
   "id": "apiToken",
   "label": "MS Teams API Token",
   "type": "text"
  },
  {
   "id": "reconnect",
   "label": "Reconnect",
   "type": "boolean",
   "default": true,
   "help": "Reconnect on WebSocket error (after 5 secs)"
  }
 ],
 "actions": [
  {
   "id": "toggleMute",
   "name": "Toggle mute",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"action\":\"toggle-mute\",\"parameters\":{},\"requestId\":1}",
    "encoding": "text"
   }
  },
  {
   "id": "toggleVideo",
   "name": "Toggle video",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"action\":\"toggle-video\",\"parameters\":{},\"requestId\":1}",
    "encoding": "text"
   }
  },
  {
   "id": "leaveMeeting",
   "name": "Leave meeting",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"action\":\"leave-call\",\"parameters\":{},\"requestId\":1}",
    "encoding": "text"
   }
  },
  {
   "id": "toggleBackgroundBlur",
   "name": "Toggle background blur",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"action\":\"toggle-background-blur\",\"parameters\":{},\"requestId\":1}",
    "encoding": "text"
   }
  },
  {
   "id": "toggleHand",
   "name": "Toggle raising hand",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"action\":\"toggle-hand\",\"parameters\":{},\"requestId\":1}",
    "encoding": "text"
   }
  },
  {
   "id": "reaction",
   "name": "Reaction",
   "options": [
    {
     "id": "selectedReaction",
     "label": "Reaction",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "0",
       "label": "Applause"
      },
      {
       "id": "1",
       "label": "Laugh"
      },
      {
       "id": "2",
       "label": "Like"
      },
      {
       "id": "3",
       "label": "Heart"
      },
      {
       "id": "4",
       "label": "Wow"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"action\":\"send-reaction\",\"parameters\":{\"type\":\"{{option.selectedReaction|map}}\"},\"requestId\":1}",
    "encoding": "text"
   },
   "maps": {
    "selectedReaction": {
     "0": "applause",
     "1": "laugh",
     "2": "like",
     "3": "love",
     "4": "wow"
    }
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "presets": [
