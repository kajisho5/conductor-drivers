 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 10024,
   "min": 1,
   "max": 65535
  },
  {
   "id": "scan",
   "label": "Scan network for XAir mixers?",
   "type": "boolean",
   "default": true
  },
  {
   "id": "model",
   "label": "Select Model",
   "type": "select",
   "default": "X18",
   "choices": [
    {
     "id": "XR12",
     "label": "XAir 12 Rack"
    },
    {
     "id": "XR16",
     "label": "XAir 16 Rack"
    },
    {
     "id": "XR18",
     "label": "XAir 18 Rack"
    },
    {
     "id": "X18",
     "label": "XAir 18 Desk"
    }
   ],
   "help": "This model is assumed when mixer is offline"
  },
  {
   "id": "mixer",
   "label": "Select Mixer by Name",
   "type": "select",
   "default": "none",
   "choices": [
    {
     "id": "none",
     "label": "No XAir units located"
    }
   ],
   "help": "Name and IP of mixers on the network"
  }
 ],
