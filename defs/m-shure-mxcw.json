{
 "format": 1,
 "id": "m-shure-mxcw",
 "name": "Shure Microflex Complete Wireless (MXCW)",
 "category": "Shure",
 "version": "1.1.0",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 2202,
   "min": 1,
   "max": 65535
  },
  {
   "id": "meteringOn",
   "label": "Enable Metering?",
   "type": "boolean",
   "default": true
  },
  {
   "id": "range",
   "label": "Seat Numbers to Control",
   "type": "text",
   "default": "1-50",
   "help": "Enter a range and/or comma separated numbers, e.g.: 1-30, 40, 50-59.  Valid seats are 1-65535"
  },
  {
   "id": "meteringInterval",
   "label": "Metering Interval (in ms)",
   "type": "number",
   "default": 5000,
   "min": 500,
   "max": 99999
  },
  {
   "id": "variableFormat",
   "label": "Variable Format",
   "type": "select",
   "default": "units",
   "choices": [
    {
     "id": "units",
     "label": "Include Units"
    },
    {
     "id": "numeric",
     "label": "Numeric Only"
    }
   ],
   "help": "Changing this setting will apply to new values received.  To refresh all variables with the new setting, disable and re-enable the connection after saving these settings."
  }
 ],
 "actions": [
  {
   "id": "all",
   "name": "Retrieve all supported commands",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "< GET ALL >",
    "encoding": "text"
   }
  },
  {
   "id": "all_delegate_mic_off",
   "name": "Turn all delegate microphones off",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "< SET ALL_DELEGATE_MIC_OFF TRUE >",
    "encoding": "text"
   }
  },
  {
   "id": "audio_input_speaklist",
   "name": "Show audio input speaklist",
   "options": [
    {
     "id": "choice",
     "label": "Value",
     "type": "select",
     "default": "ON",
     "choices": [
      {
       "id": "ON",
       "label": "On"
      },
      {
       "id": "OFF",
       "label": "Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "< SET AUDIO_INPUT_SPEAKLIST O{{option.choice|map}} >",
    "encoding": "text"
   },
   "maps": {
    "choice": {
     "ON": "N",
     "OFF": "FF"
    }
   }
  },
  {
   "id": "aux_input_agc",
   "name": "Set aux input AGC",
   "options": [
    {
     "id": "choice",
     "label": "Value",
     "type": "select",
     "default": "ON",
     "choices": [
      {
       "id": "ON",
       "label": "On"
      },
      {
       "id": "OFF",
       "label": "Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "< SET 1 AUX_INPUT_AGC O{{option.choice|map}} >",
    "encoding": "text"
   },
   "maps": {
    "choice": {
     "ON": "N",
     "OFF": "FF"
    }
   }
  },
  {
   "id": "aux_input_gain",
   "name": "Set aux input gain",
   "options": [
    {
     "id": "gain",
     "label": "Gain Value (dB)",
     "type": "number",
     "default": 0,
     "min": -30,
     "max": 10
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "< SET 1 AUX_INPUT_GAIN {{option.gain|lin:1:30}} >",
