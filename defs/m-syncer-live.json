{
 "format": 1,
 "id": "m-syncer-live",
 "name": "Zusor Syncer.live",
 "category": "Zusor",
 "version": "1.0.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "https://syncer.live",
   "placeholder": "http://192.168.0.10",
   "mono": true
  }
 ],
 "actions": [
  {
   "id": "set_syncer",
   "name": "Set Syncer State",
   "options": [
    {
     "id": "groupId",
     "label": "Remote Group ID",
     "type": "text"
    },
    {
     "id": "show",
     "label": "Show",
     "type": "select",
     "default": "true",
     "choices": [
      {
       "id": "true",
       "label": "True"
      },
      {
       "id": "false",
       "label": "False"
      },
      {
       "id": "toggle",
       "label": "Toggle"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/control?groupId={{option.groupId}}",
    "body": "{\"show\":\"{{option.show|map}}e\"}",
    "contentType": "application/json"
   },
   "maps": {
    "show": {
     "true": "tru",
     "false": "fals",
     "toggle": "toggl"
    }
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/bitfocus/companion-module-syncer-live",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：Tobias Messner"
  }
 ],
 "source": {
  "module": "syncer-live",
  "version": "1.0.0",
  "license": "MIT",
  "maintainers": [
   "Tobias Messner"
  ],
  "repository": "git+https://github.com/bitfocus/companion-module-syncer-live.git"
 }
}
