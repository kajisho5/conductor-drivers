{
 "format": 1,
 "id": "m-powersoft-amplifiers",
 "name": "Powersoft Amplifier",
 "category": "Powersoft",
 "version": "1.0.1",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "mode",
   "label": "Mode",
   "type": "select",
   "default": "single",
   "choices": [
    {
     "id": "single",
     "label": "Single device"
    },
    {
     "id": "multi",
     "label": "Multiple devices"
    }
   ],
   "help": "Choose whether this instance controls a single device or multiple devices."
  },
  {
   "id": "useHttps",
   "label": "Use HTTPS",
   "type": "boolean",
   "default": false
  },
  {
   "id": "username",
   "label": "Username (if required)",
   "type": "text",
   "default": ""
  },
  {
   "id": "password",
   "label": "Password",
   "type": "text",
   "default": ""
  },
  {
   "id": "pollingInterval",
   "label": "Polling Interval (ms)",
   "type": "number",
   "default": 1000,
   "min": 100,
   "max": 10000
  },
  {
   "id": "devicesCsv",
   "label": "Devices IPs (comma or newline separated)",
   "type": "text",
   "default": "",
   "help": "Optional: List of device IPs for multi-device control in a single instance. Leave empty to use the single Host/Port above."
  },
  {
   "id": "maxChannels",
   "label": "Maximum Number of Channels",
   "type": "number",
   "default": 8,
   "min": 1,
   "max": 32
  },
  {
   "id": "decimalPlaces",
   "label": "Decimal Places",
   "type": "number",
   "default": 3,
   "min": 0,
   "max": 3
  },
  {
   "id": "powerPath",
   "label": "Power/Standby Parameter Path (override)",
   "type": "text",
   "default": "",
   "help": "Optional: Specify the exact parameter path for power/standby if discovery fails. Example: /Device/ReadOnly/Power/State"
  },
  {
   "id": "enableUdpFeedback",
   "label": "Enable UDP feedback polling (second API)",
   "type": "boolean",
   "default": false,
   "help": "When enabled, the module will read power/mutes/alarms via UDP port 1234. Writes continue to use HTTP API."
  },
  {
   "id": "udpPort",
   "label": "UDP Device Port",
   "type": "number",
   "default": 1234,
   "min": 1,
   "max": 65535
  },
  {
   "id": "udpPollInterval",
   "label": "UDP Poll Interval (ms)",
   "type": "number",
   "default": 1000,
   "min": 200,
   "max": 10000
  },
  {
   "id": "udpAnswerPortZero",
   "label": "Force answer_port=0",
   "type": "boolean",
   "default": false,
   "help": "Some firmware answers only when answer_port=0 is used (observed in tests)."
  }
 ],
 "actions": [
  {
   "id": "powerOn",
   "name": "Power On",
   "options": [
    {
     "id": "device",
     "label": "Device",
     "type": "select",
     "default": "10.11.12.13",
     "choices": [
      {
       "id": "10.11.12.13",
       "label": "10.11.12.13"
      }
     ],
     "help": "Select target device. Defaults to first device if not set."
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/am",
    "body": "{\"version\":\"1.0.0\",\"clientId\":\"x8-panel\",\"payload\":{\"type\":100,\"action\":{\"type\":20,\"values\":[{\"id\":\"/Device/Audio/Presets/Live/Generals/Standby/Value\",\"data\":{\"type\":40,\"boolValue\":false}}]}},\"tag\":1,\"updateId\":1}",
