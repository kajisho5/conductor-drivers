{
 "format": 1,
 "id": "m-softron-mreplay",
 "name": "Softron M|Replay",
 "category": "Softron",
 "version": "1.0.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:8090",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "password",
   "label": "Password (optional)",
   "type": "text",
   "default": ""
  }
 ],
 "actions": [
  {
   "id": "selectOutput",
   "name": "Select Output",
   "options": [
    {
     "id": "output",
     "label": "Output",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/outputs/",
    "body": "{\"selected\":true}",
    "contentType": "application/json"
   }
  },
  {
   "id": "assignInputToOutput",
   "name": "Assign Input to Output",
   "options": [
    {
     "id": "output",
     "label": "Output",
     "type": "text",
     "default": ""
    },
    {
     "id": "input",
     "label": "Input",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/outputs/",
    "body": "{\"input_unique_id\":\"\"}",
    "contentType": "application/json"
   }
  },
  {
   "id": "createMarker",
   "name": "Create Marker",
   "options": [
    {
     "id": "markerName",
     "label": "Marker Name",
     "type": "text",
     "default": "New Marker"
    },
    {
     "id": "reference",
     "label": "Reference",
     "type": "select",
     "default": "live",
     "choices": [
      {
       "id": "live",
       "label": "Live"
      },
      {
       "id": "playhead",
       "label": "Playhead"
      },
      {
       "id": "absolute",
       "label": "Absolute"
      }
     ]
    },
    {
     "id": "time",
     "label": "Time/Offset (timecode or seconds)",
     "type": "text",
     "default": "0"
    },
    {
     "id": "input",
     "label": "Input",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/markers",
    "body": "{\"name\":\"{{option.markerName}}\",\"reference\":\"{{option.reference|map}}\":\"{{option.time}}\"}",
    "contentType": "application/json"
   },
   "maps": {
    "reference": {
     "live": "live\",\"offset",
     "playhead": "playhead\",\"offset",
     "absolute": "absolute\",\"time"
    }
   }
  },
  {
   "id": "setPlaybackRate",
   "name": "Set Playback Rate",
   "options": [
    {
     "id": "rate",
     "label": "Playback Rate",
     "type": "number",
     "default": 1,
     "min": -32,
     "max": 32,
     "help": "Range: -32 to 32. Use decimals for speeds between -1 and 1 (e.g., 0.33, 0.5). 0 = stop, 1 = normal, -1 = reverse"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/set_playback_rate?rate={{option.rate}}"
   }
  },
  {
   "id": "setPosition",
   "name": "Go to Position",
   "options": [
    {
     "id": "reference",
     "label": "Reference",
     "type": "select",
     "default": "live",
     "choices": [
      {
       "id": "live",
       "label": "Live"
      },
      {
       "id": "playhead",
       "label": "Playhead"
      },
      {
       "id": "absolute",
       "label": "Absolute"
      },
      {
       "id": "in_point",
       "label": "In Point"
      },
      {
       "id": "out_point",
       "label": "Out Point"
      }
     ]
    },
    {
     "id": "position",
     "label": "Position (timecode or seconds)",
     "type": "text",
     "default": "0",
     "help": "Use positive/negative numbers for offset, or timecode (e.g., 01:00:00:00)"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/set_position?position={{option.position}}&reference={{option.reference|map}}"
   },
   "maps": {
    "reference": {
     "live": "live",
     "playhead": "playhead",
     "absolute": "absolute",
     "in_point": "in_point",
     "out_point": "out_point"
    }
   }
  },
  {
   "id": "playlistPlay",
   "name": "Playlist - Play",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists//play"
   }
  },
  {
   "id": "playlistPause",
   "name": "Playlist - Pause",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists//pause"
   }
  },
  {
   "id": "playlistStop",
   "name": "Playlist - Stop",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists//stop"
   }
  },
  {
   "id": "playlistSkipPrevious",
   "name": "Playlist - Skip Previous",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists//skip_previous"
   }
  },
  {
   "id": "playlistSkipNext",
   "name": "Playlist - Skip Next",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists//skip_next"
   }
  },
  {
   "id": "playlistPlayItem",
   "name": "Playlist - Play Specific Clip",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist",
     "type": "text",
     "default": ""
    },
    {
     "id": "item",
     "label": "Clip Index/ID/Name",
     "type": "text",
     "default": "0"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists//items/{{option.item}}/play"
   }
  },
  {
   "id": "playlistPauseItem",
   "name": "Playlist - Pause Specific Clip",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist",
     "type": "text",
     "default": ""
    },
    {
     "id": "item",
     "label": "Clip Index/ID/Name",
     "type": "text",
     "default": "0"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists//items/{{option.item}}/pause"
   }
  }
 ],
