   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 23,
   "min": 1,
   "max": 65535
  },
  {
   "id": "udp",
   "label": "Use UDP",
   "type": "boolean",
   "default": false,
   "help": "Connect via UDP instead of TCP"
  },
  {
   "id": "keepAlive",
   "label": "Poll Interval",
   "type": "number",
   "default": 60,
   "min": 0,
   "max": 180,
   "help": "Seconds, set to 0 to turn off"
  },
  {
   "id": "meterRate",
