   "id": "isTalkingThreshold",
   "label": "Talking Threshold",
   "type": "number",
   "default": -3,
   "min": -24,
   "max": 0,
   "help": "Automix gain threshold for Is Talking function"
  }
 ],
 "actions": [
  {
   "id": "sc_recall",
   "name": "Scene - Recall",
   "options": [
    {
     "id": "name",
     "label": "Scene Name",
     "type": "text",
     "default": "Factory Defaults",
     "help": "Max Length: 15 char"
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "SNR,Factory Defaults\\r\\n",
    "encoding": "text"
   }
  },
  {
   "id": "sc_save",
   "name": "Scene - Save",
   "options": [
    {
     "id": "name",
     "label": "Scene Name",
     "type": "text",
     "default": "New Scene",
     "help": "Max Length: 15 char"
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "SNS,New Scene\\r\\nGS\\r\\n",
    "encoding": "text"
   }
  },
  {
   "id": "sc_newsave",
   "name": "Scene - Save New",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "SNN\\r\\n",
    "encoding": "text"
   }
  },
  {
   "id": "recall_default",
   "name": "Recall Defaults",
   "options": [
    {
     "id": "mode",
     "label": "Channel or Matrix",
     "type": "select",
     "default": "FP",
     "choices": [
      {
       "id": "FP",
       "label": "Channel Defaults"
      },
      {
       "id": "RM",
       "label": "Matrix Defaults"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{{option.mode|map}}\\r\\n",
    "encoding": "text"
   },
   "maps": {
    "mode": {
     "FP": "FP",
     "RM": "RM"
    }
   }
  },
  {
   "id": "query_meters",
   "name": "Metering",
   "options": [
    {
     "id": "mode",
     "label": "Meter Type",
     "type": "select",
     "default": "GS",
     "choices": [
      {
       "id": "GS",
       "label": "Channel Status"
      },
      {
       "id": "GSA",
       "label": "Automix Gains"
      },
      {
       "id": "GSS",
       "label": "Signal Presence"
      },
      {
       "id": "GSI",
       "label": "Input Peaks"
      },
      {
       "id": "GSO",
       "label": "Output Peaks"
      },
      {
       "id": "GSM",
       "label": "Music Reference Peaks"
      },
      {
       "id": "GSN",
       "label": "NOM Gain Limits"
      },
      {
       "id": "GSX",
       "label": "Matrix Output Meters"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "GS{{option.mode|map}}\\r\\n",
    "encoding": "text"
   },
   "maps": {
    "mode": {
     "GS": "",
     "GSA": "A",
     "GSS": "S",
     "GSI": "I",
     "GSO": "\\r\\nGSO",
     "GSM": "M",
     "GSN": "N",
     "GSX": "X"
    }
   }
  }
