{
 "format": 1,
 "id": "m-dcc-ex-commandstation",
 "name": "DCC-EX",
 "category": "DCC-EX",
 "version": "2.3.0",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 2560,
   "min": 1,
   "max": 65535
  },
  {
   "id": "region",
   "label": "User interface labels",
   "type": "select",
   "default": "Point",
   "choices": [
    {
     "id": "Point",
     "label": "Points"
    },
    {
     "id": "Turnout",
     "label": "Turnouts"
    }
   ]
  }
 ],
 "actions": [
  {
   "id": "power",
   "name": "Power Control",
   "options": [
    {
     "id": "power",
     "label": "Power Control",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "1 MAIN",
       "label": "On Main"
      },
      {
       "id": "1 PROG",
       "label": "On Prog"
      },
      {
       "id": "1 JOIN",
       "label": "On Join"
      },
      {
       "id": "1",
       "label": "On Both Tracks"
      },
      {
       "id": "0 MAIN",
       "label": "Off Main"
      },
      {
       "id": "0 PROG",
       "label": "Off Prog"
      },
      {
       "id": "0",
       "label": "Off Both Tracks"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "<{{option.power|map}}>\\r",
    "encoding": "text"
   },
   "maps": {
    "power": {
     "0": "0",
     "1": "1",
     "1 MAIN": "1 MAIN",
     "1 PROG": "1 PROG",
     "1 JOIN": "1 JOIN",
     "0 MAIN": "0 MAIN",
     "0 PROG": "0 PROG"
    }
   }
  },
  {
   "id": "stop",
   "name": "Emergency Stop",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "<!>\\r",
    "encoding": "text"
   }
  },
  {
   "id": "reset",
   "name": "Reset Command Station",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "<D RESET>\\r",
    "encoding": "text"
   }
  },
  {
   "id": "throttle",
   "name": "Throttle",
   "options": [
    {
     "id": "address",
     "label": "DCC Address",
     "type": "text",
     "default": "3",
     "help": "Use $(conn1:locoAddress) if you want to change the DCC address using a separate select loco action button"
    },
    {
     "id": "speed",
     "label": "Speed",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 126
    },
    {
     "id": "direction",
     "label": "Direction",
     "type": "select",
     "default": "1",
     "choices": [
      {
       "id": "1",
       "label": "Forward"
      },
      {
       "id": "0",
       "label": "Reverse"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "<t {{option.address}} {{option.speed}} {{option.direction|map}}>\\r",
    "encoding": "text"
   },
   "maps": {
    "direction": {
     "0": "0",
     "1": "1"
    }
   }
  },
  {
   "id": "function",
   "name": "Decoder Function",
   "options": [
    {
     "id": "address",
     "label": "DCC Address",
     "type": "text",
     "default": "3",
     "help": "Use $(conn1:locoAddress) if you want to change the DCC address using a separate select loco action button"
    },
    {
     "id": "decoderFunction",
     "label": "Function",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 68
    },
    {
     "id": "functionState",
     "label": "State",
     "type": "boolean",
     "default": false
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "<F {{option.address}} {{option.decoderFunction}} {{option.functionState|map}}>\\r",
    "encoding": "text"
   },
   "maps": {
    "functionState": {
     "false": "0",
     "true": "1"
    }
   }
  },
  {
   "id": "accessorySubAddress",
   "name": "Accessory (address and sub-address)",
   "options": [
    {
     "id": "address",
     "label": "Address",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 511
    },
    {
     "id": "subAddress",
     "label": "Sub-Address",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 3
    },
    {
     "id": "functionState",
     "label": "State",
     "type": "boolean",
     "default": false
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "<a {{option.address}} {{option.subAddress}} {{option.functionState|map}}>\\r",
    "encoding": "text"
   },
   "maps": {
    "functionState": {
     "false": "0",
     "true": "1"
    }
   }
  },
  {
   "id": "accessoryLinear",
   "name": "Accessory (linear address)",
   "options": [
    {
     "id": "address",
     "label": "Address",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 2044
    },
    {
     "id": "functionState",
     "label": "State",
     "type": "boolean",
     "default": false
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "<a {{option.address}} {{option.functionState|map}}>\\r",
    "encoding": "text"
   },
   "maps": {
    "functionState": {
     "false": "0",
     "true": "1"
    }
   }
  },
  {
   "id": "turnout",
   "name": "Point Control",
   "options": [
    {
     "id": "address",
     "label": "Address",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 32767
    },
    {
     "id": "state",
     "label": "State",
     "type": "select",
     "default": "1",
     "choices": [
      {
       "id": "1",
       "label": "Throw"
      },
      {
       "id": "0",
       "label": "Close"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "<T {{option.address}} {{option.state|map}}>\\r",
    "encoding": "text"
   },
   "maps": {
    "state": {
     "0": "0",
     "1": "1"
    }
   }
  },
  {
   "id": "locoSelect",
   "name": "Set Loco Address Variable",
   "options": [
    {
     "id": "loco",
     "label": "Loco address variable (A, B, C, D)",
     "type": "select",
     "default": "A",
     "choices": [
      {
       "id": "A",
       "label": "A"
      },
      {
       "id": "B",
       "label": "B"
      },
      {
       "id": "C",
       "label": "C"
      },
      {
       "id": "D",
       "label": "D"
      }
     ]
    },
    {
     "id": "address",
     "label": "DCC address for currently selected loco variable",
     "type": "number",
     "default": 3,
     "min": 1,
     "max": 10293
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "<t {{option.address}}>\\r",
    "encoding": "text"
   }
  },
  {
   "id": "custom",
   "name": "Custom Command",
   "options": [
    {
     "id": "customCommand",
     "label": "Custom command string",
     "type": "text"
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{{option.customCommand}}\\r",
    "encoding": "text"
   }
  }
 ],
 "feedbacks": [],
