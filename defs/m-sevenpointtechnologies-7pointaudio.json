{
 "format": 1,
 "id": "m-sevenpointtechnologies-7pointaudio",
 "name": "Seven Point Technologies, LLC 7 Point Audio",
 "category": "Seven Point Technologies, LLC",
 "version": "1.1.0",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 7788,
   "min": 1,
   "max": 65535
  }
 ],
 "actions": [
  {
   "id": "announcement",
   "name": "Announcement",
   "options": [
    {
     "id": "announcementState",
     "label": "Announcement Control",
     "type": "select",
     "default": "toggle",
     "choices": [
      {
       "id": "toggle",
       "label": "Toggle Announcement"
      },
      {
       "id": "on",
       "label": "Announcement On"
      },
      {
       "id": "off",
       "label": "Announcement Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "announcement{{option.announcementState|map}}",
    "encoding": "text"
   },
   "maps": {
    "announcementState": {
     "toggle": "",
     "on": " 1",
     "off": " 0"
    }
   }
  },
  {
   "id": "compressor",
   "name": "Compressor",
