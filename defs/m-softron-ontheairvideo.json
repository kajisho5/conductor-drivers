{
 "format": 1,
 "id": "m-softron-ontheairvideo",
 "name": "Softron OnTheAir Video",
 "category": "Softron",
 "version": "2.3.1",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:8081",
   "placeholder": "http://192.168.0.10",
   "mono": true
  }
 ],
 "actions": [
  {
   "id": "play",
   "name": "Play",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist (optional, name/index)",
     "type": "text",
     "default": "",
     "help": "Enter an index (zero based) or name of a playlist"
    },
    {
     "id": "clip",
     "label": "Clip index/name (optional)",
     "type": "text",
     "default": "",
     "help": "Enter an index (zero based) or name for a clip"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists/{{option.playlist}}/items/{{option.clip}}/play"
   }
  },
  {
   "id": "playPosition",
   "name": "Play clip at position",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist",
     "type": "text",
     "default": "0",
     "help": "Enter an index (zero based) or name of a playlist"
    },
    {
     "id": "clip",
     "label": "Clip index/name (optional)",
     "type": "text",
     "default": "",
     "help": "Enter an index (zero based) or name for a clip"
    },
    {
     "id": "type",
     "label": "Position type",
     "type": "select",
     "choices": [
      {
       "id": "relativeTimecode",
       "label": "Relative Timecode"
      },
      {
       "id": "mediaTimecode",
       "label": "Media Timecode"
      },
      {
       "id": "relativeSeconds",
       "label": "Relative Seconds"
      }
     ]
    },
    {
     "id": "position",
     "label": "Time (timecode or seconds)",
     "type": "text"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists/{{option.playlist}}/items/{{option.clip}}/play?position_{{option.type|map}}={{option.position}}"
   },
   "maps": {
    "type": {
     "relativeTimecode": "relative_timecode",
     "mediaTimecode": "media_timecode",
     "relativeSeconds": "relative_seconds"
    }
   }
  },
  {
   "id": "pause",
   "name": "Pause",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist (optional, name/index)",
     "type": "text",
     "default": "",
     "help": "Enter an index (zero based) or name of a playlist"
    },
    {
     "id": "clip",
     "label": "Clip index/name (optional)",
     "type": "text",
     "default": "",
     "help": "Enter an index (zero based) or name for a clip"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists/{{option.playlist}}/items/{{option.clip}}/pause"
   }
  },
  {
   "id": "pausePosition",
   "name": "Pause clip at position",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist",
     "type": "text",
     "default": "0",
     "help": "Enter an index (zero based) or name of a playlist"
    },
    {
     "id": "clip",
     "label": "Clip index/name (optional)",
     "type": "text",
     "default": "",
     "help": "Enter an index (zero based) or name for a clip"
    },
    {
     "id": "type",
     "label": "Position type",
     "type": "select",
     "choices": [
      {
       "id": "relativeTimecode",
       "label": "Relative Timecode"
      },
      {
       "id": "mediaTimecode",
       "label": "Media Timecode"
      },
      {
       "id": "relativeSeconds",
       "label": "Relative Seconds"
      }
     ]
    },
    {
     "id": "position",
     "label": "Time (timecode or seconds)",
     "type": "text"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists/{{option.playlist}}/items/{{option.clip}}/pause?position_{{option.type|map}}={{option.position}}"
   },
   "maps": {
    "type": {
     "relativeTimecode": "relative_timecode",
     "mediaTimecode": "media_timecode",
     "relativeSeconds": "relative_seconds"
    }
   }
  },
  {
   "id": "resume",
   "name": "Resume",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist (optional, name/index)",
     "type": "text",
     "default": "",
     "help": "Enter an index (zero based) or name of a playlist"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists/{{option.playlist}}/resume"
   }
  },
  {
   "id": "stop",
   "name": "Stop",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist (optional, name/index)",
     "type": "text",
     "default": "",
     "help": "Enter an index (zero based) or name of a playlist"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists/{{option.playlist}}/stop"
   }
  },
  {
   "id": "skipNext",
   "name": "Skip to next clip",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist (optional, name/index)",
     "type": "text",
     "default": "",
     "help": "Enter an index (zero based) or name of a playlist"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists/{{option.playlist}}/skip_next"
   }
  },
  {
   "id": "skipPrevious",
   "name": "Skip to previous clip",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist (optional, name/index)",
     "type": "text",
     "default": "",
     "help": "Enter an index (zero based) or name of a playlist"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists/{{option.playlist}}/previous"
   }
  },
  {
   "id": "joinInProgress",
   "name": "Join In Progress",
   "options": [
    {
     "id": "playlist",
     "label": "Playlist (optional, name/index)",
     "type": "text",
     "default": "",
     "help": "Enter an index (zero based) or name of a playlist"
    },
    {
     "id": "clip",
     "label": "Clip (optional, index/UID)",
     "type": "text",
     "default": "",
     "help": "Enter an index (zero based) or UID for a clip"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playlists/{{option.playlist}}/items/{{option.clip}}/join_in_progress"
   }
  },
  {
   "id": "gpiTrigger",
   "name": "Toggle Virtual GPI",
   "options": [
    {
     "id": "input",
     "label": "GPI Input",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 25,
     "help": "GPI input number (1-25)"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playback/gpi_trigger?input={{option.input}}"
   }
  },
  {
   "id": "cueTrigger",
   "name": "Cue Trigger (Space Bar)",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playback/cue_trigger"
   }
  },
  {
   "id": "cgPlay",
   "name": "CG Project - Play",
   "options": [
    {
     "id": "project",
     "label": "CG Project",
     "type": "text",
     "default": "",
     "help": "Select a CG project"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playback/cg_projects//play"
   }
  },
  {
   "id": "cgPause",
   "name": "CG Project - Pause",
   "options": [
    {
     "id": "project",
     "label": "CG Project",
     "type": "text",
     "default": "",
     "help": "Select a CG project"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playback/cg_projects//pause"
   }
  },
  {
   "id": "cgStop",
   "name": "CG Project - Stop",
   "options": [
    {
     "id": "project",
     "label": "CG Project",
     "type": "text",
     "default": "",
     "help": "Select a CG project"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/playback/cg_projects//stop"
   }
  },
  {
   "id": "runAction",
   "name": "Run Action (AppleScript)",
   "options": [
    {
     "id": "action",
     "label": "Action",
     "type": "text",
     "default": "",
     "help": "Select an available action to run"
    },
    {
     "id": "parameter",
     "label": "Parameter (optional)",
     "type": "text",
     "default": "",
     "help": "Optional parameter to pass to the action"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/actions//run?parameter={{option.parameter}}"
   }
  }
 ],
