{
 "format": 1,
 "id": "m-netron-en",
 "name": "Netron EN / EN-12",
 "category": "Netron",
 "version": "1.1.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "polling",
   "label": "Polling",
   "type": "boolean",
   "default": true
  },
  {
   "id": "pollingRate",
   "label": "Polling Rate (ms)",
   "type": "number",
   "default": 500,
   "min": 100,
   "max": 5000
  },
  {
   "id": "verbose",
   "label": "Enable Verbose Logging",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "runCue",
   "name": "Run Cue",
   "options": [
    {
     "id": "cueNumber",
     "label": "Cue Number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 99
    },
    {
     "id": "resendEthernet",
     "label": "Resend Ethernet",
     "type": "boolean",
     "default": true
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/run_cues",
    "body": "CueResendEth={{option.resendEthernet|map}}&RunCue={{option.cueNumber}}&EndFlag=1",
    "contentType": "application/x-www-form-urlencoded"
   },
   "maps": {
    "resendEthernet": {
     "true": "1",
     "false": "0"
    }
   }
  },
  {
   "id": "saveCue",
   "name": "Save Cue",
   "options": [
    {
     "id": "cueNumber",
     "label": "Cue Number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 99
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/save_cues",
    "body": "CueNum={{option.cueNumber}}&EndFlag=1",
    "contentType": "application/x-www-form-urlencoded"
   }
  },
  {
   "id": "clearCue",
   "name": "Clear Cue",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/run_cues",
    "body": "CueResendEth=1&RunCue=0&EndFlag=1",
    "contentType": "application/x-www-form-urlencoded"
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
