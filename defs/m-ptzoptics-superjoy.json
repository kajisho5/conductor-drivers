{
 "format": 1,
 "id": "m-ptzoptics-superjoy",
 "name": "PTZ Optics SuperJoy",
 "category": "PTZ Optics",
 "version": "2.0.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  }
 ],
 "actions": [
  {
   "id": "hdmiout",
   "name": "HDMI Output Control",
   "options": [
    {
     "id": "hdmicontrol",
     "label": "Choose Control Behavior",
     "type": "select",
     "default": "toggle",
     "choices": [
      {
       "id": "toggle",
       "label": "Toggle"
      },
      {
       "id": "off",
       "label": "Off"
      },
      {
       "id": "on",
       "label": "On"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/joyctrl.cgi?f=hdmiout&action={{option.hdmicontrol|map}}"
   },
   "maps": {
    "hdmicontrol": {
     "toggle": "toggle",
     "off": "off",
     "on": "on"
    }
   }
  },
  {
   "id": "custom",
   "name": "Trigger Custom Button",
   "options": [
    {
     "id": "buttonid",
     "label": "Custom Button to Trigger (1 - 5)",
     "type": "text",
     "default": "1"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/joyctrl.cgi?f=custom&action=trigger&buttonid=1"
   }
  },
  {
   "id": "camselect",
   "name": "Select Group and Camera",
   "options": [
    {
     "id": "group",
     "label": "Group (1 - 5)",
     "type": "text",
     "default": "1"
    },
    {
     "id": "id",
     "label": "Camera ID",
     "type": "text",
     "default": "1"
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/joyctrl.cgi?f=camselect&group=1&camid=1"
   }
  }
 ],
