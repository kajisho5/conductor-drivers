{
 "format": 1,
 "id": "m-figure53-qlab-advance",
 "name": "Figure 53 QLab with feedback",
 "category": "Figure 53",
 "version": "2.13.0",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 53000,
   "min": 1,
   "max": 65535
  },
  {
   "id": "useTCP",
   "label": "Use TCP?",
   "type": "boolean",
   "default": true,
   "help": "Use TCP instead of UDP\nRequired for feedbacks and variables"
  },
  {
   "id": "useTenths",
   "label": "Use Tenths?",
   "type": "boolean",
   "default": false,
   "help": "Show .1 second resolution for cue remaining timer?\nOtherwise offset countdown by +1 second\nRequires TCP"
  },
  {
   "id": "exposeVariables",
   "label": "Expose cue name variables?",
   "type": "boolean",
   "default": false,
   "help": "Variables for the name of each cue number and cue ID are normally hidden\nin the Variable List. Enabling this will allow them to be searched in the\nlist but may also cause excessive clutter"
  },
  {
   "id": "passcode",
   "label": "OSC Passcode",
   "type": "text",
   "help": "The passcode to controll QLab.\nLeave blank if not needed\nThis is almost always required for QLab5"
  },
  {
   "id": "workspace",
   "label": "Workspace",
   "type": "select",
   "default": "default",
   "choices": [
    {
     "id": "default",
     "label": "Default Workspace"
    }
   ],
   "help": "Select a target workspace\n(or Default/selected)"
  },
  {
   "id": "cuelist",
   "label": "Cue List",
   "type": "select",
   "default": "default",
   "choices": [
    {
     "id": "default",
     "label": "Default Cue List"
    }
   ],
   "help": "Specific Cue List for Play Head control\n(or use Default/selected)"
  }
 ],
