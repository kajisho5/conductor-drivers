    {
     "id": "uuid",
     "label": "UUID",
     "type": "text",
     "default": "0"
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/live/animations/{{option.uuid}}/move",
    "body": "",
    "contentType": "application/x-www-form-urlencoded"
   }
  },
  {
   "id": "tlPlayingToggle",
   "name": "TimeLine Play Pause",
   "options": [
    {
