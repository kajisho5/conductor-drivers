{
 "format": 1,
 "id": "m-smodetech-smodelive",
 "name": "Smode Live",
 "category": "Smode",
 "version": "1.1.2",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:8080",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "httpMode",
   "label": "Http Mode",
   "type": "select",
   "default": "http",
   "choices": [
    {
     "id": "http",
     "label": "Http"
    },
    {
     "id": "https",
     "label": "Https"
    },
    {
     "id": "httpsWithCa",
     "label": "Https with certificate authority"
    }
   ]
  },
  {
   "id": "rejectUnauthorized",
   "label": "Reject Unauthorized",
   "type": "boolean",
   "default": true
  },
  {
   "id": "certFilePath",
   "label": "Certifacte File Path",
   "type": "text"
  },
  {
   "id": "keyFilePath",
   "label": "Key File Path",
   "type": "text"
  },
  {
   "id": "certAuthorityFilePath",
   "label": "Certificate authority File Path",
   "type": "text"
  },
  {
   "id": "password",
   "label": "Password",
   "type": "text",
   "default": "Password"
  },
  {
   "id": "pollingInterval",
   "label": "Status Poll Interval",
   "type": "number",
   "default": 1000,
   "min": 0
  },
  {
   "id": "autoDevices",
   "label": "Auto Devices",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "markersMove",
   "name": "TimeLines Marker Move",
