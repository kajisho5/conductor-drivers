{
 "format": 1,
 "id": "m-shure-mxa910",
 "name": "Shure MXA910 / MXA920",
 "category": "Shure",
 "version": "2.0.1",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 2202,
   "min": 1,
   "max": 65535
  }
 ],
 "actions": [
  {
   "id": "device_mute",
   "name": "Mute or Unmute Device",
   "options": [
    {
     "id": "choice",
     "label": "Mute/Unmute/Toggle",
     "type": "select",
     "default": "ON",
     "choices": [
      {
       "id": "ON",
       "label": "Mute"
      },
      {
       "id": "OFF",
       "label": "Unmute"
      },
      {
       "id": "TOGGLE",
       "label": "Toggle Mute/Unmute"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "< SET DEVICE_AUDIO_MUTE {{option.choice|map}} >",
    "encoding": "text"
   },
   "maps": {
    "choice": {
     "ON": "ON",
     "OFF": "OFF",
     "TOGGLE": "TOGGLE"
    }
   }
  },
