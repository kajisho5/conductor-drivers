{
 "format": 1,
 "id": "m-kenku-fm",
 "name": "KenkuFM API Controller",
 "category": "KenkuFM",
 "version": "1.0.1",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:3333",
   "placeholder": "http://192.168.0.10",
   "mono": true
  }
 ],
 "actions": [
  {
   "id": "playlist_toggle_playback",
   "name": "Playlist: Toggle Play/Pause",
   "options": [],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/v1/playlist/playback/play",
    "body": ""
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/v1/playlist/playback"
    }
   ]
  },
  {
   "id": "playlist_play_next",
   "name": "Playlist: Play Next",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/v1/playlist/playback/next",
    "body": ""
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/v1/playlist/playback"
    }
   ]
  },
  {
   "id": "playlist_play_previous",
   "name": "Playlist: Play Previous",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/v1/playlist/playback/previous",
    "body": ""
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/v1/playlist/playback"
    }
   ]
  },
  {
   "id": "playlist_toggle_shuffle",
   "name": "Playlist: Toggle Shuffle",
   "options": [],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/v1/playlist/playback/shuffle",
    "body": "{\"shuffle\":true}",
    "contentType": "application/json"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/v1/playlist/playback"
    }
   ]
  },
  {
   "id": "playlist_toggle_repeat",
   "name": "Playlist: Toggle Repeat",
   "options": [],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/v1/playlist/playback/repeat",
    "body": "{\"repeat\":\"track\"}",
    "contentType": "application/json"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/v1/playlist/playback"
    }
   ]
  },
  {
   "id": "playlist_set_repeat",
   "name": "Playlist: Set Repeat",
   "options": [
    {
     "id": "repeat_state",
     "label": "Repeat State",
     "type": "select",
     "default": "off",
     "choices": [
      {
       "id": "track",
       "label": "Track"
      },
      {
       "id": "playlist",
       "label": "Playlist"
      },
      {
       "id": "off",
       "label": "Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/v1/playlist/playback/repeat",
    "body": "{\"repeat\":\"{{option.repeat_state|map}}\"}",
    "contentType": "application/json"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/v1/playlist/playback"
    }
   ],
   "maps": {
    "repeat_state": {
     "off": "off",
     "track": "track",
     "playlist": "playlist"
    }
   }
  },
  {
   "id": "playlist_toggle_mute",
   "name": "Playlist: Toggle Mute",
   "options": [],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/v1/playlist/playback/mute",
    "body": "{\"mute\":true}",
    "contentType": "application/json"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/v1/playlist/playback"
    }
   ]
  },
  {
   "id": "playlist_adjust_volume",
   "name": "Playlist: Adjust Volume",
   "options": [
    {
     "id": "volume_step",
     "label": "Volume Step",
     "type": "number",
     "default": 10,
     "min": -100,
     "max": 100
    }
   ],
   "send": {
    "kind": "http",
    "method": "PUT",
    "path": "/v1/playlist/playback/volume",
    "body": "{\"volume\":null}",
    "contentType": "application/json"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/v1/playlist/playback"
    }
   ]
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/bitfocus/companion-module-kenku-fm",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：Schemen"
  }
 ],
 "source": {
  "module": "kenku-fm",
  "version": "1.0.1",
  "license": "MIT",
  "maintainers": [
   "Schemen"
  ],
  "repository": "git+https://github.com/bitfocus/companion-module-kenku-fm.git"
 }
}
