{
 "format": 1,
 "id": "m-barco-pulse",
 "name": "Barco UDX Pulse Projector",
 "category": "Barco",
 "version": "2.3.0",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 9090,
   "min": 1,
   "max": 65535
  },
  {
   "id": "polling",
   "label": "Enable Polling",
   "type": "boolean",
   "default": false
  },
  {
   "id": "interval",
   "label": "Update Interval",
   "type": "text",
   "default": "2000"
  },
  {
   "id": "verbose",
   "label": "Enable Verbose Logging",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "illumination",
   "name": "Illumination",
   "options": [
    {
     "id": "p1",
     "label": "illumination",
     "type": "select",
     "default": "illumination.ignite",
     "choices": [
      {
       "id": "illumination.extinguish",
       "label": "Extinguish"
      },
      {
       "id": "illumination.ignite",
       "label": "Illuminate"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"method\":\"illumination.{{option.p1|map}}\",\"params\":{},\"jsonrpc\":\"2.0\"}",
    "encoding": "text"
   },
   "maps": {
    "p1": {
     "illumination.ignite": "ignite\",\"id\":\"10",
     "illumination.extinguish": "extinguish\",\"id\":\"11"
    }
   }
  },
  {
   "id": "osd",
   "name": "OSD on",
   "options": [
    {
     "id": "p1",
     "label": "Show OSD?",
     "type": "select",
     "default": "true",
     "choices": [
      {
       "id": "true",
       "label": "On"
      },
      {
       "id": "false",
       "label": "Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"method\":\"property.set\",\"id\":\"1{{option.p1|map}}e\"},\"jsonrpc\":\"2.0\"}",
    "encoding": "text"
   },
   "maps": {
    "p1": {
     "true": "2\",\"params\":{\"property\":\"ui.osd\",\"value\":\"tru",
     "false": "3\",\"params\":{\"property\":\"ui.osd\",\"value\":\"fals"
    }
   }
  },
  {
   "id": "input",
   "name": "Select input",
   "options": [
    {
     "id": "p1",
     "label": "input",
     "type": "select",
     "default": "L1 HDMI",
     "choices": [
      {
       "id": "L1 HDMI",
       "label": "HDMI"
      },
      {
       "id": "L1 Displayport",
       "label": "Displayport"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"method\":\"property.set\",\"id\":\"1{{option.p1|map}}\"},\"jsonrpc\":\"2.0\"}",
    "encoding": "text"
   },
   "maps": {
    "p1": {
     "L1 HDMI": "4\",\"params\":{\"property\":\"image.window.main.source\",\"value\":\"L1 HDMI",
     "L1 Displayport": "5\",\"params\":{\"property\":\"image.window.main.source\",\"value\":\"L1 Displayport"
    }
   }
  },
  {
   "id": "shutter",
   "name": "Shutter projector",
   "options": [
    {
     "id": "p1",
     "label": "shutter open/close",
     "type": "select",
     "default": "Open",
     "choices": [
      {
       "id": "Open",
       "label": "Shutter open"
      },
      {
       "id": "Closed",
       "label": "Shutter close"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"method\":\"property.set\",\"id\":\"1{{option.p1|map}}\"},\"jsonrpc\":\"2.0\"}",
    "encoding": "text"
   },
   "maps": {
    "p1": {
     "Open": "6\",\"params\":{\"property\":\"optics.shutter.target\",\"value\":\"Open",
     "Closed": "7\",\"params\":{\"property\":\"optics.shutter.target\",\"value\":\"Closed"
    }
   }
  },
  {
   "id": "shutter_toggle",
   "name": "Shutter projector (Toggle)",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"method\":\"optics.shutter.toggle\",\"id\":\"18\",\"params\":{},\"jsonrpc\":\"2.0\"}",
    "encoding": "text"
   }
  },
  {
   "id": "testpattern",
   "name": "Test Pattern on/off",
   "options": [
    {
     "id": "p1",
     "label": "on/off",
     "type": "select",
     "default": "true",
     "choices": [
      {
       "id": "true",
       "label": "On"
      },
      {
       "id": "false",
       "label": "Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"method\":\"property.set\",\"id\":\"{{option.p1|map}}e\"},\"jsonrpc\":\"2.0\"}",
    "encoding": "text"
   },
   "maps": {
    "p1": {
     "true": "19\",\"params\":{\"property\":\"image.testpattern.show\",\"value\":\"tru",
     "false": "20\",\"params\":{\"property\":\"image.testpattern.show\",\"value\":\"fals"
    }
   }
  },
  {
   "id": "stealth",
   "name": "Stealth Mode (LEDs)",
   "options": [
    {
     "id": "p1",
     "label": "Controllable LEDs on/off",
     "type": "select",
     "default": "true",
     "choices": [
      {
       "id": "true",
       "label": "On"
      },
      {
       "id": "false",
       "label": "Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"method\":\"property.set\",\"id\":\"2{{option.p1|map}}e\"},\"jsonrpc\":\"2.0\"}",
    "encoding": "text"
   },
   "maps": {
    "p1": {
     "true": "1\",\"params\":{\"property\":\"ui.stealthmode\",\"value\":\"tru",
     "false": "2\",\"params\":{\"property\":\"ui.stealthmode\",\"value\":\"fals"
    }
   }
  },
  {
   "id": "stealth_toggle",
   "name": "Stealth Mode (Toggle)",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"method\":\"ui.togglestealthmode\",\"id\":\"23\",\"params\":{},\"jsonrpc\":\"2.0\"}",
    "encoding": "text"
   }
  },
  {
   "id": "lens_calibrate",
   "name": "Calibrate lens",
   "options": [
    {
     "id": "p1",
     "label": "Type",
     "type": "select",
     "default": "optics.zoom.calibrate",
     "choices": [
      {
       "id": "optics.zoom.calibrate",
       "label": "Calibrate Zoom"
      },
      {
       "id": "optics.focus.calibrate",
       "label": "Calibrate Focus"
      },
      {
       "id": "optics.lensshift.vertical.calibrate",
       "label": "Calibrate Vertical"
      },
      {
       "id": "optics.lensshift.horizontal.calibrate",
       "label": "Calibrate Horizontal"
      },
      {
       "id": "optics.shifttocenter",
       "label": "Go To Center"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"method\":\"optics.{{option.p1|map}}\",\"params\":{},\"jsonrpc\":\"2.0\"}",
    "encoding": "text"
   },
   "maps": {
    "p1": {
     "optics.zoom.calibrate": "zoom.calibrate\",\"id\":\"47",
     "optics.focus.calibrate": "focus.calibrate\",\"id\":\"48",
     "optics.lensshift.vertical.calibrate": "lensshift.vertical.calibrate\",\"id\":\"49",
     "optics.lensshift.horizontal.calibrate": "lensshift.horizontal.calibrate\",\"id\":\"50",
     "optics.shifttocenter": "shifttocenter\",\"id\":\"51"
    }
   }
  },
  {
   "id": "factory",
   "name": "Reset to factory defaults",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"method\":\"system.resetall\",\"id\":\"120\",\"params\":{},\"jsonrpc\":\"2.0\"}",
    "encoding": "text"
   }
  }
 ],
