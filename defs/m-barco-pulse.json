{
 "format": 1,
 "id": "m-barco-pulse",
 "name": "Barco UDX Pulse Projector",
 "category": "Barco",
 "version": "2.3.0",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 9090,
   "min": 1,
   "max": 65535
  },
  {
   "id": "polling",
   "label": "Enable Polling",
   "type": "boolean",
   "default": false
  },
  {
   "id": "interval",
   "label": "Update Interval",
   "type": "text",
   "default": "2000"
  },
  {
   "id": "verbose",
   "label": "Enable Verbose Logging",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "illumination",
   "name": "Illumination",
   "options": [
    {
     "id": "p1",
     "label": "illumination",
     "type": "select",
     "default": "illumination.ignite",
     "choices": [
      {
       "id": "illumination.extinguish",
       "label": "Extinguish"
      },
      {
       "id": "illumination.ignite",
       "label": "Illuminate"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"method\":\"illumination.{{option.p1|map}}\",\"id\":\"1\",\"params\":{},\"jsonrpc\":\"2.0\"}",
    "encoding": "text"
   },
   "maps": {
    "p1": {
     "illumination.ignite": "ignite",
     "illumination.extinguish": "extinguish"
    }
   }
  },
  {
