   "name": "OSD on",
   "options": [
    {
     "id": "p1",
     "label": "Show OSD?",
     "type": "select",
     "default": "true",
     "choices": [
      {
       "id": "true",
       "label": "On"
      },
      {
       "id": "false",
       "label": "Off"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"method\":\"property.set\",\"id\":\"1\",\"params\":{\"property\":\"ui.osd\",\"value\":\"{{option.p1|map}}e\"},\"jsonrpc\":\"2.0\"}",
    "encoding": "text"
   },
   "maps": {
    "p1": {
