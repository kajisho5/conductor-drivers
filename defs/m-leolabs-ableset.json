   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 39051,
   "min": 1,
   "max": 65535
  },
  {
   "id": "serverHost",
   "label": "Server Hosts/IPs",
   "type": "text",
   "default": "127.0.0.1",
   "help": "Please enter the host(s) you'd like to connect to. If AbleSet is running on the same computer as Companion, leave this as 127.0.0.1. You can provide multiple hosts separated by commas for a redundant "
  },
  {
   "id": "fineUpdates",
   "label": "Fine Updates",
   "type": "boolean",
   "default": true,
   "help": "Disable this if it causes performance issues. With this enabled, progress bars are updated every 40ms, otherwise they are updated every beat."
  }
 ],
