{
 "format": 1,
 "id": "m-foscam-ptz",
 "name": "foscam PTZ Camera",
 "category": "foscam",
 "version": "2.0.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10:88",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "user",
   "label": "User name",
   "type": "text",
   "help": "The username for authentication"
  },
  {
   "id": "password",
   "label": "Password",
   "type": "text",
   "help": "The password for authentication"
  }
 ],
 "actions": [
  {
   "id": "left",
   "name": "Pan Left",
   "options": [
    {
     "id": "speed",
     "label": "Speed",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "0",
       "label": "0 fast"
      },
      {
       "id": "1",
       "label": "1"
      },
      {
       "id": "2",
       "label": "2"
      },
      {
       "id": "3",
       "label": "3"
      },
      {
       "id": "4",
       "label": "4 slow"
      },
      {
       "id": "-1",
       "label": "Default speed"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/cgi-bin/CGIProxy.fcgi?usr=&pwd=&cmd={{option.speed|map}}"
   },
   "more": [
    {
     "kind": "http",
     "method": "GET",
     "path": "/cgi-bin/CGIProxy.fcgi?usr=&pwd=&cmd=ptzMoveLeft"
    }
   ],
   "maps": {
    "speed": {
     "0": "setPTZSpeed&speed=0",
     "1": "setPTZSpeed&speed=1",
     "2": "setPTZSpeed&speed=2",
     "3": "setPTZSpeed&speed=3",
     "4": "setPTZSpeed&speed=4",
     "-1": "ptzMoveLeft"
    }
   }
  },
