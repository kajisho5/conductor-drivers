{
 "format": 1,
 "id": "m-soundcraft-ui",
 "name": "Soundcraft Ui12 / Ui16 / Ui24R",
 "category": "Soundcraft",
 "version": "3.10.0",
 "minAppVersion": "0.6.0",
 "transport": "ws",
 "wsPath": "/",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 80,
   "min": 1,
   "max": 65535
  },
  {
   "id": "enableFaderLevelVars",
   "label": "Enable Fader Level variables (dB)",
   "type": "boolean",
   "default": false
  },
  {
   "id": "enableFaderLevelVarsPct",
   "label": "Enable Fader Level variables (%)",
   "type": "boolean",
   "default": false
  },
  {
   "id": "enablePanVars",
   "label": "Enable PAN variables",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "changemastervalue",
   "name": "Master: Change fader value (relative)",
   "options": [
    {
     "id": "value",
     "label": "Change value (dB)",
     "type": "number",
     "default": 3,
     "min": -100,
     "max": 100
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "3:::SETD^m.mix^1",
    "encoding": "text"
   }
  },
  {
   "id": "mutemasterchannel",
   "name": "Master channels: Mute",
   "options": [
    {
     "id": "channelType",
     "label": "Channel Type",
     "type": "select",
     "default": "i",
     "choices": [
      {
       "id": "i",
       "label": "Input"
      },
      {
       "id": "l",
       "label": "Line Input"
      },
      {
       "id": "p",
       "label": "Player"
      },
      {
       "id": "f",
       "label": "FX"
      },
      {
       "id": "s",
       "label": "Sub Group"
      },
      {
       "id": "a",
       "label": "AUX Master"
      },
      {
       "id": "v",
       "label": "VCA"
      }
     ]
    },
    {
     "id": "channel",
     "label": "Channel number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 24
    },
    {
     "id": "mute",
     "label": "Mute",
     "type": "select",
     "default": "2",
     "choices": [
      {
       "id": "2",
       "label": "Toggle"
      },
      {
       "id": "1",
       "label": "Mute"
      },
      {
       "id": "0",
       "label": "Unmute"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "3:::SETD^{{option.channelType|map}}.{{option.channel|lin:1:-1}}.mute^{{option.mute|map}}",
    "encoding": "text"
   },
   "more": [
    {
     "kind": "bytes",
     "data": "3:::SETD^{{option.channelType|map}}.{{option.channel|lin:1:-1}}.mute^{{option.mute|map}}",
     "encoding": "text"
    }
   ],
   "maps": {
    "channelType": {
     "i": "i",
     "l": "l",
     "p": "p",
     "f": "f",
     "s": "s",
     "a": "a",
     "v": "v"
    },
    "mute": {
     "0": "0",
     "1": "1",
     "2": "1"
    }
   }
  },
  {
   "id": "setmasterchanneldelay",
   "name": "Master channels: Set output delay",
   "options": [
    {
     "id": "channelType",
     "label": "Channel Type",
     "type": "select",
     "default": "i",
     "choices": [
      {
       "id": "i",
       "label": "Input"
      },
      {
       "id": "l",
       "label": "Line Input"
      },
      {
       "id": "a",
       "label": "AUX Master"
      }
     ]
    },
    {
     "id": "channel",
     "label": "Channel number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 24
    },
    {
     "id": "time",
     "label": "Delay time (ms)",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 500
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "3:::SETD^{{option.channelType|map}}.{{option.channel|lin:1:-1}}.delay^0.{{option.time|pad3}}",
    "encoding": "text"
   },
   "maps": {
    "channelType": {
     "i": "i",
     "l": "l",
     "a": "a"
