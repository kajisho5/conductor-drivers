{
 "format": 1,
 "id": "m-atlasied-atmosphere",
 "name": "AtlasIED Atmosphere",
 "category": "AtlasIED",
 "version": "1.2.0",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 5321,
   "min": 1,
   "max": 65535
  },
  {
   "id": "controllerId",
   "label": "Controller ID",
   "type": "number",
   "default": 10
  },
  {
   "id": "verbose",
   "label": "Enable Verbose Logging",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "source_gain_set_percent",
   "name": "Set Source Gain By Percent",
   "options": [
    {
     "id": "number",
     "label": "Number",
     "type": "text",
     "default": "0",
     "help": "i.e. If third party parameter is SourceGain_0, enter 0 here."
    },
    {
     "id": "percent",
     "label": "Gain Percent",
     "type": "text",
     "default": "50"
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"jsonrpc\":\"2.0\",\"method\":\"set\",\"params\":[{\"param\":\"SourceGain_{{option.number}}\",\"pct\":{{option.percent}}}],\"id\":1}\\n",
    "encoding": "text"
   }
  },
  {
   "id": "source_mute",
   "name": "Set Source Mute",
   "options": [
    {
     "id": "number",
     "label": "Number",
     "type": "text",
     "default": "0",
     "help": "i.e. If third party parameter is SourceMute_0, enter 0 here."
    },
    {
     "id": "mute",
     "label": "Mute On/Off",
     "type": "boolean",
     "default": true
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"jsonrpc\":\"2.0\",\"method\":\"set\",\"params\":[{\"param\":\"SourceMute_{{option.number}}\",\"val\":{{option.mute|map}}}],\"id\":1}\\n",
    "encoding": "text"
   },
   "maps": {
    "mute": {
     "true": "1",
     "false": "0"
    }
   }
  },
  {
   "id": "mix_gain_set_percent",
   "name": "Set Mix Gain By Percent",
