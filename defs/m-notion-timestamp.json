{
 "format": 1,
 "id": "m-notion-timestamp",
 "name": "Notion Timestamp",
 "category": "Notion",
 "version": "2.1.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "https://api.notion.com",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "apiKey",
   "label": "Notion API Key",
   "type": "text"
  },
  {
   "id": "parentPageId",
   "label": "Parent Page ID",
   "type": "text"
  }
 ],
 "actions": [
  {
   "id": "startSession",
   "name": "Start a Session",
   "options": [
    {
     "id": "databaseName",
     "label": "Database Name",
     "type": "text",
     "default": ""
    },
    {
     "id": "autoCreateStartRecord",
     "label": "Automatically create start record?",
     "type": "boolean",
     "default": false
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/v1/databases/",
    "body": "{\"parent\":{\"type\":\"page_id\",\"page_id\":\"\"},\"title\":[{\"type\":\"text\",\"text\":{\"content\":\"{{option.databaseName}}\"}}],\"properties\":{\"message\":{\"title\":{}},\"companionTimeMillis\":{\"number\":{}},\"companionTimeDate\":{\"rich_text\":{}},\"elapsedTime\":{\"number\":{}},\"timestampValue\":{\"rich_text\":{}},\"createTime\":{\"created_time\":{}},\"loggingDetails\":{\"rich_text\":{}}}}",
    "contentType": "application/json"
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/bitfocus/companion-module-notion-timestamp",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：Darin Pope, Justin James"
  }
 ],
 "source": {
  "module": "notion-timestamp",
  "version": "2.1.0",
  "license": "MIT",
  "maintainers": [
   "Darin Pope",
   "Justin James"
  ],
  "repository": "git+https://github.com/bitfocus/companion-module-notion-timestamp.git"
 }
}
