{
 "format": 1,
 "id": "m-captionkit-api",
 "name": "CaptionKit API",
 "category": "CaptionKit",
 "version": "1.0.1",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "https://api.captionkit.io",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "key",
   "label": "CaptionKit API Key",
   "type": "text"
  }
 ],
 "actions": [
  {
   "id": "send_signal",
   "name": "Send Signal",
   "options": [
    {
     "id": "signal",
     "label": "Signal type",
     "type": "select",
     "default": "captions:stream:start",
     "choices": [
      {
       "id": "captions:stream:start",
       "label": "Start streaming captions"
      },
      {
       "id": "captions:stream:stop",
       "label": "Stop streaming captions"
      },
      {
       "id": "captions:stream:clear",
       "label": "Clear caption text"
      },
      {
       "id": "captions:pending:on",
       "label": "Turn on \"Starting soon\" message"
      },
      {
       "id": "captions:pending:off",
       "label": "Turn off \"Starting soon\" message"
      },
      {
       "id": "captions:visibility:hide",
       "label": "Temporarily hide captions"
      },
      {
       "id": "captions:visibility:show",
       "label": "Show captions"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/v2/signal?key=",
    "body": "{\"event\":\"captions:{{option.signal|map}}\"}",
    "contentType": "application/json"
   },
   "maps": {
    "signal": {
     "captions:stream:start": "stream:start",
     "captions:stream:stop": "stream:stop",
     "captions:stream:clear": "stream:clear",
     "captions:pending:on": "pending:on",
     "captions:pending:off": "pending:off",
     "captions:visibility:hide": "visibility:hide",
     "captions:visibility:show": "visibility:show"
    }
   }
  },
  {
   "id": "language_select",
   "name": "Set transcription language",
