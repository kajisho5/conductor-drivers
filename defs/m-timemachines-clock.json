{
 "format": 1,
 "id": "m-timemachines-clock",
 "name": "TimeMachines Clock",
 "category": "TimeMachines",
 "version": "2.1.1",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 7372,
   "min": 1,
   "max": 65535
  },
  {
   "id": "polling",
   "label": "Polling (Required for Variables/Feedback)",
   "type": "boolean",
   "default": true
  }
 ],
 "actions": [
  {
   "id": "showTimeOfDay",
   "name": "Show Time Of Day",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "a80100",
    "encoding": "hex"
   }
  },
  {
   "id": "countUpTimerMode",
   "name": "Show Count-Up Timer",
   "options": [
    {
     "id": "mode",
     "label": "Display Mode",
     "type": "select",
     "default": "sec",
     "choices": [
      {
       "id": "sec",
       "label": "Hours, Minutes, & Seconds"
      },
      {
       "id": "tsec",
       "label": "Minutes, Seconds, & Tenths of Seconds"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "a2{{option.mode|map}}00",
    "encoding": "hex"
   },
   "maps": {
    "mode": {
     "sec": "01",
     "tsec": "00"
    }
   }
  },
  {
   "id": "startCountUpTimer",
   "name": "Start Count-Up Timer",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "a30100",
    "encoding": "hex"
   }
  },
  {
   "id": "pauseCountUpTimer",
   "name": "Pause Count-Up Timer",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "a30000",
    "encoding": "hex"
   }
  },
  {
   "id": "resetCountUpTimer",
   "name": "Reset Count-Up Timer",
   "options": [
    {
     "id": "mode",
     "label": "Display Mode",
     "type": "select",
     "default": "sec",
     "choices": [
      {
       "id": "sec",
       "label": "Hours, Minutes, & Seconds"
      },
      {
       "id": "tsec",
       "label": "Minutes, Seconds, & Tenths of Seconds"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "a4{{option.mode|map}}00",
    "encoding": "hex"
   },
   "maps": {
    "mode": {
     "sec": "01",
     "tsec": "00"
    }
   }
  },
  {
   "id": "setUpTimerWhileRunning",
   "name": "Set Count-Up Timer While Running",
   "options": [
    {
     "id": "hours",
     "label": "Hours",
     "type": "number",
     "default": 0,
     "min": 0
    },
    {
     "id": "minutes",
     "label": "Minutes",
     "type": "number",
     "default": 30,
     "min": 0,
     "max": 59
    },
    {
     "id": "seconds",
     "label": "Seconds",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 59
    },
    {
     "id": "tseconds",
     "label": "Tenths Of Seconds",
     "type": "number",
     "default": 0,
     "min": 0
    },
    {
     "id": "hseconds",
     "label": "Hundredths Of Seconds",
     "type": "number",
     "default": 0,
     "min": 0
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "aa{{option.hours|u8}}{{option.minutes|u8}}{{option.seconds|u8}}{{option.tseconds|u8}}{{option.hseconds|u8}}",
    "encoding": "hex"
   }
  },
  {
   "id": "startCountDownTimer",
   "name": "Start Countdown Timer",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "a60100",
    "encoding": "hex"
   }
  },
  {
   "id": "pauseCountDownTimer",
   "name": "Pause Countdown Timer",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "a60000",
    "encoding": "hex"
   }
  },
  {
   "id": "setDownTimerWhileRunning",
   "name": "Set Countdown Timer While Running",
   "options": [
    {
     "id": "hours",
     "label": "Hours",
     "type": "number",
     "default": 0,
     "min": 0
    },
    {
     "id": "minutes",
     "label": "Minutes",
     "type": "number",
     "default": 30,
     "min": 0,
     "max": 59
    },
    {
     "id": "seconds",
     "label": "Seconds",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 59
    },
    {
     "id": "tseconds",
     "label": "Tenths Of Seconds",
     "type": "number",
     "default": 0,
     "min": 0
    },
    {
     "id": "hseconds",
     "label": "Hundredths Of Seconds",
     "type": "number",
     "default": 0,
     "min": 0
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "ab{{option.hours|u8}}{{option.minutes|u8}}{{option.seconds|u8}}{{option.tseconds|u8}}{{option.hseconds|u8}}",
    "encoding": "hex"
   }
  },
  {
   "id": "increaseTimerWhileRunning",
   "name": "Increase Timer While Running",
   "options": [
    {
     "id": "hours",
     "label": "Hours",
     "type": "number",
     "default": 0,
     "min": 0
    },
    {
     "id": "minutes",
     "label": "Minutes",
     "type": "number",
     "default": 30,
     "min": 0,
     "max": 59
    },
    {
     "id": "seconds",
     "label": "Seconds",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 59
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "ab{{option.hours|u8}}{{option.minutes|u8}}{{option.seconds|u8}}0000",
    "encoding": "hex"
   }
  },
  {
   "id": "decreaseTimerWhileRunning",
   "name": "Decrease Timer While Running",
   "options": [
    {
     "id": "hours",
     "label": "Hours",
     "type": "number",
     "default": 0,
     "min": 0
    },
    {
     "id": "minutes",
     "label": "Minutes",
     "type": "number",
     "default": 30,
     "min": 0,
     "max": 59
    },
    {
     "id": "seconds",
     "label": "Seconds",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 59
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "ab",
    "encoding": "hex"
   }
  },
  {
   "id": "executeStoredProgram",
   "name": "Execute Stored Program",
   "options": [
    {
     "id": "program",
     "label": "Program Number (0 to 9)",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 9
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "b8{{option.program|u8}}",
    "encoding": "hex"
   }
  },
  {
   "id": "relayControl",
   "name": "Close Relay",
   "options": [
    {
     "id": "seconds",
     "label": "Seconds to stay Closed",
     "type": "number",
     "default": 1,
     "min": 1
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "b4{{option.seconds|u8}}",
    "encoding": "hex"
   }
  },
  {
   "id": "displayBrightness",
   "name": "Set Display Brightness",
   "options": [
    {
     "id": "digit",
     "label": "Digit Brightness (0 - 100)",
     "type": "number",
     "default": 100,
     "min": 0,
     "max": 100
    },
    {
     "id": "dot",
     "label": "Dot/Colon Brightness (0 - 100)",
     "type": "number",
     "default": 100,
     "min": 0,
     "max": 100
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "b5{{option.digit|u8}}{{option.dot|u8}}",
    "encoding": "hex"
   }
  }
 ],
