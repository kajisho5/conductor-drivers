{
 "format": 1,
 "id": "m-interspace-mastercuev7",
 "name": "Interspace Industries MasterCue V7",
 "category": "Interspace Industries",
 "version": "1.0.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "unitId",
   "label": "MasterCue ID (shown on screen)",
   "type": "text",
   "default": "001-123-456"
  }
 ],
 "actions": [
  {
   "id": "set_output_action",
   "name": "Set Output",
   "options": [
    {
     "id": "outputNumber",
     "label": "Output Number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 6
    },
    {
     "id": "outputState",
     "label": "Setting",
     "type": "select",
     "default": "outputOn",
     "choices": [
      {
       "id": "outputOn",
       "label": "Enabled"
      },
      {
       "id": "outputOff",
       "label": "Disabled"
      },
      {
       "id": "outputToggle",
       "label": "Toggle"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/command/001-123-456",
    "body": "{\"command\":\"output{{option.outputState|map}}\",\"index\":{{option.outputNumber|lin:1:-1}}}",
    "contentType": "application/json"
   },
   "maps": {
    "outputState": {
     "outputOn": "On",
     "outputOff": "Off",
     "outputToggle": "Toggle"
    }
   }
  },
  {
   "id": "suspend_action",
   "name": "Suspend All",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/command/001-123-456",
    "body": "{\"command\":\"suspendOutputs\"}",
    "contentType": "application/json"
   }
  },
  {
   "id": "resume_action",
   "name": "Resume All",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/command/001-123-456",
    "body": "{\"command\":\"resumeOutputs\"}",
    "contentType": "application/json"
   }
  },
  {
   "id": "clear_all_handsets_action",
   "name": "Clear Handsets",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/command/001-123-456",
    "body": "{\"command\":\"clearAllHandsets\"}",
    "contentType": "application/json"
   }
  },
  {
   "id": "factory_reset_action",
   "name": "Factory Reset",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/command/001-123-456",
    "body": "{\"command\":\"factoryReset\"}",
    "contentType": "application/json"
   }
  }
 ],
