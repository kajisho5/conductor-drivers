{
 "format": 1,
 "id": "m-idk-msd",
 "name": "IDK MSD-V4 / MSD-V6",
 "category": "IDK",
 "version": "1.0.1",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 1100,
   "min": 1,
   "max": 65535
  },
  {
   "id": "model",
   "label": "Model",
   "type": "select",
   "default": "msd-v4",
   "choices": [
    {
     "id": "msd-v4",
     "label": "MSD-V4"
    },
    {
     "id": "msd-v6",
     "label": "MSD-V6"
    }
   ]
  },
  {
   "id": "polling",
   "label": "Enable Polling",
   "type": "boolean",
   "default": false
  },
  {
   "id": "pollInterval",
   "label": "Polling Interval (ms)",
   "type": "number",
   "default": 1000,
   "min": 100,
   "max": 10000
  },
  {
   "id": "verbose",
   "label": "Enable Verbose Logging",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "SSW",
   "name": "Switch Video and Audio Channel Simultaneously",
   "options": [
    {
     "id": "input",
     "label": "Input Channel",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "0",
       "label": "OFF"
      },
      {
       "id": "1",
       "label": "IN 1"
      },
      {
       "id": "2",
       "label": "IN 2"
      },
      {
       "id": "3",
       "label": "IN 3"
      },
      {
       "id": "4",
       "label": "IN 4"
      }
     ]
    },
    {
     "id": "output",
     "label": "Output Window",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "0",
       "label": "All Windows"
      },
      {
       "id": "1",
       "label": "Out 1 Main Window"
      },
      {
       "id": "2",
       "label": "Out 2 Main Window"
      },
      {
       "id": "201",
       "label": "Out 1 PinP Window"
      },
      {
       "id": "202",
       "label": "Out 2 PinP Window"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "@SSW,{{option.input|map}},{{option.output|map}}\\r\\n",
    "encoding": "text"
   },
   "maps": {
    "input": {
     "0": "0",
     "1": "1",
     "2": "2",
     "3": "3",
     "4": "4"
    },
    "output": {
     "0": "0",
     "1": "1",
     "2": "2",
     "201": "201",
     "202": "202"
    }
   }
  },
