{
 "format": 1,
 "id": "m-disguise-smc",
 "name": "Disguise - SMC",
 "category": "Disguise",
 "version": "2.0.0",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "username",
   "label": "Username",
   "type": "text"
  },
  {
   "id": "password",
   "label": "Password",
   "type": "text"
  }
 ],
 "actions": [
  {
   "id": "power_on",
   "name": "Power On",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/chassis/power/on",
    "body": "{}",
    "contentType": "application/json"
   }
  },
  {
   "id": "power_off",
   "name": "Power Off",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/chassis/power/off",
    "body": "{}",
    "contentType": "application/json"
   }
  },
  {
   "id": "power_cycle",
   "name": "Power Cycle",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/chassis/power/cycle",
    "body": "{}",
    "contentType": "application/json"
   }
  },
  {
   "id": "who_am_i",
   "name": "Flash LCD",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/chassis/whoami",
    "body": "{}",
    "contentType": "application/json"
   }
  },
  {
   "id": "set_strip",
   "name": "Set LED Strip",
   "options": [
    {
     "id": "mode",
     "label": "Select Mode",
     "type": "select",
     "default": "static",
     "choices": [
      {
       "id": "static",
       "label": "Static"
      },
      {
       "id": "colour_id",
       "label": "Colour ID"
      },
      {
       "id": "rainbow",
       "label": "Rainbow"
      }
     ]
    },
    {
     "id": "red",
     "label": "Red",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 255
    },
    {
     "id": "green",
     "label": "Green",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 255
    },
    {
     "id": "blue",
     "label": "Blue",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 255
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/ledstrip",
    "body": "{\"ledMode\":\"{{option.mode|map}}\",\"ledR\":{{option.red}},\"ledG\":{{option.green}},\"ledB\":{{option.blue}}}",
    "contentType": "application/json"
   },
   "maps": {
    "mode": {
     "static": "static",
     "colour_id": "colour_id",
     "rainbow": "rainbow"
    }
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "presets": [
  {
   "id": "power_on",
   "category": "Power",
   "name": "Power On",
   "text": "Power On",
   "backgroundColor": "#000000",
   "action": {
    "definitionId": "power_on",
    "options": {}
   }
  },
  {
   "id": "power_off",
   "category": "Power",
   "name": "Power Off",
   "text": "Power Off",
   "backgroundColor": "#000000",
   "action": {
    "definitionId": "power_off",
    "options": {}
   }
  }
 ],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
