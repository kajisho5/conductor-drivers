    }
   }
  },
  {
   "id": "activate_seq_3",
   "category": "Activate Sequence",
   "name": "Activate Sequence 3",
   "text": "Activate Sequence 3",
   "backgroundColor": "#660066",
   "action": {
    "definitionId": "set_activate_sequence",
    "options": {
     "seq": 3
    }
   }
  },
  {
   "id": "deactivate_seq_3",
   "category": "Deactivate Sequence",
   "name": "Deactivate Sequence 3",
   "text": "Deactivate Sequence 3",
   "backgroundColor": "#000066",
   "action": {
    "definitionId": "set_deactivate_sequence",
    "options": {
