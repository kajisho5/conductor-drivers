     "14": "14",
     "15": "15",
     "16": "16"
    }
   }
  },
  {
   "id": "get_preset",
   "name": "Get Active Preset",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "E$pst get: 1\\r",
    "encoding": "text"
   }
  },
  {
   "id": "get_off",
   "name": "Get Space Off Status",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "E$off get: 1\\r",
    "encoding": "text"
   }
  },
  {
