{
 "format": 1,
 "id": "m-etc-echo",
 "name": "ETC Echo Integration Interface",
 "category": "ETC",
 "version": "0.2.2",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 4703,
   "min": 1,
   "max": 65535
  },
  {
   "id": "selfIP",
   "label": "Network Interface",
   "type": "select",
   "default": "10.1.0.175",
   "choices": [
    {
     "id": "10.1.0.175",
     "label": "eth0 - 10.1.0.175"
    }
   ],
   "help": "Select the network interface used for connecting to Echo. This will be used to collect feedbacks."
  },
  {
   "id": "serverport",
   "label": "Listen Port",
   "type": "text",
   "default": "4703"
  },
  {
   "id": "space",
   "label": "Echo Space",
   "type": "text",
   "default": "1"
  },
  {
   "id": "fadetime",
   "label": "Default Fade Time",
   "type": "text",
   "default": "2"
  }
 ],
 "actions": [
  {
   "id": "set_off",
   "name": "Set Space Off",
   "options": [
    {
     "id": "fade_time",
     "label": "Fade Time (sec)",
     "type": "number",
     "default": 2,
     "min": 0,
     "max": 25.4
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "E$off: 1, {{option.fade_time}}\\r",
    "encoding": "text"
   }
  },
  {
   "id": "set_activate_sequence",
   "name": "Activate Sequence",
   "options": [
    {
     "id": "seq",
     "label": "Sequence Number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 4
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "E$seq act: 1, {{option.seq}}\\r",
    "encoding": "text"
   }
  },
  {
   "id": "set_deactivate_sequence",
   "name": "Deactivate Sequence",
   "options": [
    {
     "id": "seq",
     "label": "Preset Number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 4
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "E$seq dect: 1, {{option.seq}}\\r",
    "encoding": "text"
   }
  },
  {
   "id": "get_preset",
   "name": "Get Active Preset",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "E$pst get: 1\\r",
    "encoding": "text"
   }
  },
  {
   "id": "get_off",
   "name": "Get Space Off Status",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "E$off get: 1\\r",
    "encoding": "text"
   }
  },
  {
   "id": "get_sequence",
   "name": "Get Sequence Status",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "E$seq get: 1\\r",
    "encoding": "text"
   }
  },
  {
   "id": "get_sync",
   "name": "Sync",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "E$sync get: 1\\r",
    "encoding": "text"
   }
  },
  {
   "id": "get_zone_int",
   "name": "Get Zone Intensities",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "E$zone int get: 1\\r",
    "encoding": "text"
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "presets": [
  {
   "id": "preset_off",
   "category": "Presets",
   "name": "Space Off",
   "text": "Space Off",
   "backgroundColor": "#990000",
   "action": {
    "definitionId": "set_off",
    "options": {
     "fade_time": "2"
    }
   }
  },
  {
   "id": "activate_seq_1",
   "category": "Activate Sequence",
   "name": "Activate Sequence 1",
   "text": "Activate Sequence 1",
   "backgroundColor": "#660066",
   "action": {
    "definitionId": "set_activate_sequence",
    "options": {
     "seq": 1
    }
   }
  },
  {
   "id": "deactivate_seq_1",
   "category": "Deactivate Sequence",
   "name": "Deactivate Sequence 1",
   "text": "Deactivate Sequence 1",
   "backgroundColor": "#000066",
   "action": {
