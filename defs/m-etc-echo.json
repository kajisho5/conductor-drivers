{
 "format": 1,
 "id": "m-etc-echo",
 "name": "ETC Echo Integration Interface",
 "category": "ETC",
 "version": "0.2.2",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 4703,
   "min": 1,
   "max": 65535
  },
  {
   "id": "selfIP",
   "label": "Network Interface",
   "type": "select",
   "default": "10.1.0.151",
   "choices": [
    {
     "id": "10.1.0.151",
     "label": "eth0 - 10.1.0.151"
    }
   ],
   "help": "Select the network interface used for connecting to Echo. This will be used to collect feedbacks."
  },
  {
   "id": "serverport",
   "label": "Listen Port",
   "type": "text",
   "default": "4703"
  },
  {
   "id": "space",
   "label": "Echo Space",
   "type": "text",
   "default": "1"
  },
  {
   "id": "fadetime",
   "label": "Default Fade Time",
   "type": "text",
   "default": "2"
  }
 ],
 "actions": [
  {
   "id": "set_preset",
   "name": "Set Active Preset",
   "options": [
    {
     "id": "pst",
     "label": "Preset Number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 64
    },
    {
     "id": "fade_time",
     "label": "Fade Time (sec)",
     "type": "number",
     "default": 2,
     "min": 0,
     "max": 25.4
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "E$pst act: 1, {{option.pst}}, {{option.fade_time}}\\r",
    "encoding": "text"
   }
  },
  {
   "id": "set_off",
   "name": "Set Space Off",
   "options": [
    {
     "id": "fade_time",
     "label": "Fade Time (sec)",
     "type": "number",
     "default": 2,
     "min": 0,
     "max": 25.4
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "E$off: 1, {{option.fade_time}}\\r",
    "encoding": "text"
   }
  },
  {
   "id": "set_activate_sequence",
   "name": "Activate Sequence",
   "options": [
    {
     "id": "seq",
     "label": "Sequence Number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 4
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "E$seq act: 1, {{option.seq}}\\r",
    "encoding": "text"
   }
  },
  {
   "id": "set_deactivate_sequence",
   "name": "Deactivate Sequence",
   "options": [
    {
     "id": "seq",
     "label": "Preset Number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 4
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "E$seq dect: 1, {{option.seq}}\\r",
    "encoding": "text"
   }
  },
  {
   "id": "set_zone_int",
   "name": "Set Zone Intensity",
   "options": [
    {
     "id": "zone",
     "label": "Zone Number",
     "type": "select",
     "default": "1",
     "choices": [
      {
       "id": "1",
       "label": "Zone 1"
      },
      {
       "id": "2",
       "label": "Zone 2"
      },
      {
       "id": "3",
       "label": "Zone 3"
      },
      {
       "id": "4",
