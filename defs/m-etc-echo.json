      },
      {
       "id": "5",
       "label": "Zone 5"
      },
      {
       "id": "6",
       "label": "Zone 6"
      },
      {
       "id": "7",
       "label": "Zone 7"
      },
      {
       "id": "8",
       "label": "Zone 8"
      },
      {
       "id": "9",
       "label": "Zone 9"
      },
      {
       "id": "10",
       "label": "Zone 10"
      },
      {
       "id": "11",
       "label": "Zone 11"
      },
      {
       "id": "12",
       "label": "Zone 12"
      },
      {
       "id": "13",
       "label": "Zone 13"
      },
      {
       "id": "14",
       "label": "Zone 14"
      },
      {
       "id": "15",
       "label": "Zone 15"
      },
      {
       "id": "16",
       "label": "Zone 16"
      }
     ]
    },
    {
     "id": "int",
     "label": "Zone Intensity",
     "type": "number",
     "default": 255,
     "min": 0,
     "max": 255
    },
    {
     "id": "fade_time",
     "label": "Fade Time (sec)",
     "type": "number",
     "default": 2,
     "min": 0,
     "max": 25.4
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "E$zone int: 1, {{option.zone|map}}, {{option.int}}, {{option.fade_time}}\\r",
    "encoding": "text"
   },
   "maps": {
    "zone": {
     "1": "1",
     "2": "2",
