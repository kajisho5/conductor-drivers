    }
   }
  },
  {
   "id": "deactivate_seq_2",
   "category": "Deactivate Sequence",
   "name": "Deactivate Sequence 2",
   "text": "Deactivate Sequence 2",
   "backgroundColor": "#000066",
   "action": {
    "definitionId": "set_deactivate_sequence",
    "options": {
