  {
   "id": "activate_seq_4",
   "category": "Activate Sequence",
   "name": "Activate Sequence 4",
   "text": "Activate Sequence 4",
   "backgroundColor": "#660066",
   "action": {
    "definitionId": "set_activate_sequence",
    "options": {
     "seq": 4
    }
   }
