{
 "format": 1,
 "id": "m-equipson-lightshark",
 "name": "LightShark LS1 / LS-Core",
 "category": "LightShark",
 "version": "2.0.0",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 8000,
   "min": 1,
   "max": 65535
  },
  {
   "id": "receivePort",
   "label": "Receive Port",
   "type": "number",
   "default": 9000
  },
  {
   "id": "enablePolling",
   "label": "Enable Polling",
   "type": "boolean",
   "default": true
  },
  {
   "id": "pollingInterval",
   "label": "Polling interval (ms)",
   "type": "number",
   "default": 5000,
   "min": 1000,
   "max": 60000
  }
 ],
