 "actions": [
  {
   "id": "Webserver",
   "name": "Webserver ON/OFF",
   "options": [
    {
     "id": "cmd",
     "label": "Command",
     "type": "select",
     "default": "Webserver=1",
     "choices": [
      {
       "id": "Webserver=1",
       "label": "ON"
      },
      {
       "id": "Webserver=0",
       "label": "OFF"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "Webserver={{option.cmd|map}}\\n",
    "encoding": "text"
   },
   "maps": {
    "cmd": {
     "Webserver=1": "1",
     "Webserver=0": "0"
    }
   }
  },
  {
   "id": "CustomCommand",
   "name": "Custom Command",
   "options": [
    {
     "id": "cmd",
     "label": "Command:",
     "type": "text",
     "default": "",
     "help": "Custom rawpanel commands in string form"
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{{option.cmd}}\\n",
    "encoding": "text"
   }
  }
