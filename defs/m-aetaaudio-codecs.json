  {
   "id": "setCodingBitRate",
   "name": "Set Coding Bit Rate",
   "options": [
    {
     "id": "bitrate",
     "label": "Bit Rate",
     "type": "select",
     "default": "7",
     "choices": [
      {
       "id": "0",
       "label": "16 kbps"
      },
      {
       "id": "1",
       "label": "32 kbps"
      },
      {
       "id": "3",
       "label": "64 kbps"
      },
      {
       "id": "5",
       "label": "96 kbps"
      },
      {
       "id": "7",
       "label": "128 kbps"
      },
      {
       "id": "11",
       "label": "192 kbps"
      },
      {
       "id": "15",
       "label": "256 kbps"
