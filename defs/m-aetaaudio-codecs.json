     "1": "1",
     "3": "3",
     "5": "5",
     "7": "7",
     "11": "11",
     "15": "15"
    }
   }
  },
  {
   "id": "refreshData",
   "name": "Refresh Data",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "AT&VAT#SUPAT&VAT#SUP",
    "encoding": "text"
   }
  },
