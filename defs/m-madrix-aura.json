{
 "format": 1,
 "id": "m-madrix-aura",
 "name": "Madrix Aura 2/8/12/32",
 "category": "Madrix",
 "version": "1.0.1",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  }
 ],
 "actions": [
  {
   "id": "cue",
   "name": "Specific Cue",
   "options": [
    {
     "id": "value",
     "label": "Cue Number",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 255
    }
   ],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/remote.cgi?cue={{option.value}}"
   }
  },
  {
   "id": "previous_cue",
   "name": "Previous Cue",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/remote.cgi?previous"
   }
  },
  {
   "id": "next_cue",
   "name": "Next Cue",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/remote.cgi?next"
   }
  },
  {
   "id": "record",
   "name": "Record",
   "options": [],
   "send": {
    "kind": "http",
    "method": "GET",
    "path": "/remote.cgi?record"
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/verledung/companion-module-madrix-aura",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：verLEDung - LED- & Veranstaltungstechnik"
  }
 ],
