{
 "format": 1,
 "id": "m-vicreo-broadcast-titles",
 "name": "VICREO Broadcast Titles",
 "category": "VICREO",
 "version": "1.0.0",
 "minAppVersion": "0.6.0",
 "transport": "ws",
 "wsPath": "/",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 8080,
   "min": 1,
   "max": 65535
  },
  {
   "id": "reconnectInterval",
   "label": "Reconnect Interval (seconds)",
   "type": "number",
   "default": 5,
   "min": 1,
   "max": 60
  }
 ],
 "actions": [
  {
   "id": "navigate_up",
   "name": "Navigate Up",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"command\":\"up\"}",
    "encoding": "text"
   }
  },
  {
   "id": "navigate_down",
   "name": "Navigate Down",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"command\":\"down\"}",
    "encoding": "text"
   }
  },
  {
   "id": "select_row",
   "name": "Select Row",
   "options": [
    {
     "id": "index",
     "label": "Row Index (0-based)",
     "type": "number",
     "default": 0,
     "min": 0,
     "max": 999
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"command\":\"select\",\"params\":{\"index\":{{option.index}}}}",
    "encoding": "text"
   }
  },
  {
   "id": "select_row_1based",
   "name": "Select Row (1-based)",
   "options": [
    {
     "id": "row",
     "label": "Row Number (1-based)",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 1000
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"command\":\"select\",\"params\":{\"index\":{{option.row|lin:1:-1}}}}",
    "encoding": "text"
   }
  },
  {
   "id": "go_live",
   "name": "Go Live",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"command\":\"live\"}",
    "encoding": "text"
   }
  },
  {
   "id": "clear_output",
   "name": "Clear Output",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"command\":\"clear\"}",
    "encoding": "text"
   }
  },
  {
   "id": "refresh_data",
   "name": "Refresh Data",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"command\":\"refresh\"}",
    "encoding": "text"
   }
  },
  {
   "id": "get_sheets",
   "name": "Get Sheets",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"command\":\"sheets\"}",
    "encoding": "text"
   }
  },
  {
   "id": "select_and_live",
   "name": "Select Row and Go Live",
   "options": [
    {
     "id": "row",
     "label": "Row Number (1-based)",
     "type": "number",
     "default": 1,
     "min": 1,
     "max": 1000
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"command\":\"select\",\"params\":{\"index\":{{option.row|lin:1:-1}}}}",
    "encoding": "text"
   },
   "more": [
    {
     "kind": "bytes",
     "data": "{\"command\":\"live\"}",
     "encoding": "text"
    }
   ]
  },
  {
   "id": "next_and_live",
   "name": "Next Row and Go Live",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"command\":\"down\"}",
    "encoding": "text"
   },
   "more": [
    {
     "kind": "bytes",
     "data": "{\"command\":\"live\"}",
     "encoding": "text"
    }
   ]
  },
  {
   "id": "previous_and_live",
   "name": "Previous Row and Go Live",
   "options": [],
   "send": {
    "kind": "bytes",
    "data": "{\"command\":\"up\"}",
    "encoding": "text"
   },
   "more": [
    {
     "kind": "bytes",
     "data": "{\"command\":\"live\"}",
     "encoding": "text"
    }
   ]
  },
  {
   "id": "go_live_row",
   "name": "Go Live with Specific Row",
   "options": [
    {
     "id": "row",
     "label": "Row Number (1-based) - can use variables",
     "type": "text",
     "default": "1"
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"command\":\"select\",\"params\":{\"index\":{{option.row|lin:1:-1}}}}",
    "encoding": "text"
   },
   "more": [
    {
     "kind": "bytes",
     "data": "{\"command\":\"live\"}",
     "encoding": "text"
    }
   ]
  }
 ],
 "feedbacks": [],
 "variables": [],
 "presets": [
