{
 "format": 1,
 "id": "m-evision-hd102",
 "name": "Evision HD102",
 "category": "Evision",
 "version": "1.0.2",
 "minAppVersion": "0.6.0",
 "transport": "udp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 9099,
   "min": 1,
   "max": 65535
  },
  {
   "id": "pollingOn",
   "label": "Enable Polling",
   "type": "boolean",
   "default": true
  },
  {
   "id": "pollingInterval",
   "label": "Polling interval (ms)",
   "type": "text",
   "default": "1000"
  }
 ],
 "actions": [
  {
   "id": "freeze",
   "name": "Freeze",
   "options": [
    {
     "id": "state",
     "label": "State",
     "type": "select",
     "default": "ON",
     "choices": [
      {
       "id": "ON",
       "label": "ON"
      },
      {
       "id": "OFF",
       "label": "OFF"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "8411223344{{option.state|map}}0000",
    "encoding": "hex"
   },
   "more": [
    {
     "kind": "bytes",
     "data": "8411223344{{option.state|map}}0000",
     "encoding": "hex"
    }
   ],
   "maps": {
    "state": {
     "ON": "01",
     "OFF": "00"
    }
   }
  },
  {
   "id": "blackout",
   "name": "Blackout",
   "options": [
    {
     "id": "state",
     "label": "State",
     "type": "select",
     "default": "ON",
     "choices": [
      {
       "id": "ON",
       "label": "ON"
      },
      {
       "id": "OFF",
       "label": "OFF"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "8111223344{{option.state|map}}0000",
    "encoding": "hex"
   },
   "more": [
    {
     "kind": "bytes",
     "data": "8111223344{{option.state|map}}0000",
     "encoding": "hex"
    }
   ],
   "maps": {
    "state": {
     "ON": "00",
     "OFF": "01"
    }
   }
  },
  {
   "id": "test_pattern",
   "name": "Send Test Pattern",
   "options": [
    {
     "id": "pattern",
     "label": "Choose Pattern",
     "type": "select",
     "default": "0",
     "choices": [
      {
       "id": "0",
       "label": "Normal"
      },
      {
       "id": "1",
       "label": "Red"
      },
      {
       "id": "2",
       "label": "Green"
      },
      {
       "id": "3",
       "label": "Blue"
      },
      {
       "id": "4",
       "label": "White"
      },
      {
       "id": "5",
       "label": "Vertical Line"
      },
      {
       "id": "6",
       "label": "Horizontal Line"
      },
      {
       "id": "7",
       "label": "Left Slash"
      },
      {
       "id": "8",
       "label": "Right Slash"
      },
      {
       "id": "9",
       "label": "Pane"
      },
      {
       "id": "10",
       "label": "Gradient Red"
      },
      {
       "id": "11",
       "label": "Gradient Green"
      },
      {
       "id": "12",
       "label": "Gradient Blue"
      },
      {
       "id": "13",
       "label": "Gradient White"
      },
      {
       "id": "14",
       "label": "Black"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "9900000b030000{{option.pattern|map}}",
    "encoding": "hex"
   },
   "maps": {
    "pattern": {
     "0": "00ffffffa4",
     "1": "01ffffffa5",
     "2": "02ffffffa6",
     "3": "03ffffffa7",
     "4": "04ffffffa8",
     "5": "05ffffffa9",
     "6": "06ffffffaa",
     "7": "07ffffffab",
     "8": "08ffffffac",
