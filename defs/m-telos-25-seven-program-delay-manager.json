{
 "format": 1,
 "id": "m-telos-25-seven-program-delay-manager",
 "name": "Telos 25-Seven PDM/PDM II Broadcast Delay",
 "category": "Telos",
 "version": "1.1.1",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 5443,
   "min": 1,
   "max": 65535
  },
  {
   "id": "poll_interval",
   "label": "Delay Poll Interval (ms)",
   "type": "text",
   "default": 1000
  },
  {
   "id": "debug_logging",
   "label": "Enable Debug Logging",
   "type": "boolean",
   "default": false
  }
 ],
 "actions": [
  {
   "id": "trigger",
   "name": "Trigger (momentary)",
   "options": [
    {
     "id": "argument",
     "label": "Argument",
     "type": "select",
     "default": "Build",
     "choices": [
      {
       "id": "Build",
       "label": "Build"
      },
      {
       "id": "Exit",
       "label": "Exit"
      },
      {
       "id": "Cough",
       "label": "Cough"
      },
      {
       "id": "Dump",
       "label": "Dump"
      },
      {
       "id": "Bypass",
       "label": "Bypass"
      },
      {
       "id": "Custom",
       "label": "Custom..."
      }
     ]
    },
    {
     "id": "argument_custom",
     "label": "Custom Argument",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "trigger {{option.argument|map}}\\n",
    "encoding": "text"
   },
   "maps": {
    "argument": {
     "Build": "Build",
     "Exit": "Exit",
     "Cough": "Cough",
     "Dump": "Dump",
     "Bypass": "Bypass",
     "Custom": "QB1x"
    }
   }
  },
  {
   "id": "send_raw",
   "name": "Send Raw Command",
   "options": [
    {
     "id": "raw_command",
     "label": "Command",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{{option.raw_command}}\\n",
    "encoding": "text"
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "presets": [
