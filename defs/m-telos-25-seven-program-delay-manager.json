    "definitionId": "trigger",
    "options": {
     "argument": "Dump",
     "argument_custom": ""
    }
   }
  },
  {
   "id": "1",
   "category": "Controls",
   "name": "BUILD",
   "text": "BUILD",
   "backgroundColor": "#001000",
   "action": {
    "definitionId": "trigger",
    "options": {
     "argument": "Build",
     "argument_custom": ""
    }
   }
  },
  {
   "id": "2",
   "category": "Controls",
   "name": "EXIT",
   "text": "EXIT",
   "backgroundColor": "#101000",
   "action": {
    "definitionId": "trigger",
    "options": {
     "argument": "Exit",
     "argument_custom": ""
    }
   }
  },
  {
   "id": "4",
   "category": "Controls",
   "name": "BYPASS",
   "text": "BYPASS",
   "backgroundColor": "#101010",
   "action": {
    "definitionId": "trigger",
    "options": {
