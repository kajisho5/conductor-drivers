     "label": "Name (31 characters max)",
     "type": "text",
     "default": ""
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "< SET {{option.channel|map}} CHAN_NAME {{{option.name}}} >",
    "encoding": "text"
