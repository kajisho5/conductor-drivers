    {
     "id": "channel",
     "label": "Channel",
     "type": "select",
     "default": "1",
     "choices": [
      {
       "id": "1",
       "label": "Channel 1"
      },
      {
       "id": "2",
       "label": "Channel 2"
      },
      {
       "id": "3",
       "label": "Channel 3"
      },
      {
       "id": "4",
       "label": "Channel 4"
