{
 "format": 1,
 "id": "m-shure-mxw",
 "name": "Shure Microflex (MXW)",
 "category": "Shure",
 "version": "1.0.3",
 "minAppVersion": "0.6.0",
 "transport": "tcp",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 2202,
   "min": 1,
   "max": 65535
  },
  {
   "id": "modelID",
   "label": "Model Type",
   "type": "select",
   "default": "mxwapt8",
   "choices": [
    {
     "id": "mxwani4",
     "label": "MXWANI4 Quad Receiver"
    },
    {
     "id": "mxwani8",
     "label": "MXWANI8 Octo Receiver"
    },
    {
     "id": "mxwapt2",
     "label": "MXWAPT2 Dual Access Point"
    },
    {
     "id": "mxwapt4",
     "label": "MXWAPT4 Quad Access Point"
    },
    {
     "id": "mxwapt8",
     "label": "MXWAPT8 Octo Access Point"
    }
   ]
  },
  {
   "id": "meteringOn",
   "label": "Enable Metering?",
   "type": "boolean",
   "default": true
  },
  {
   "id": "meteringInterval",
   "label": "Metering Interval (in ms)",
   "type": "number",
   "default": 5000,
   "min": 500,
   "max": 99999
  },
  {
   "id": "variableFormat",
   "label": "Variable Format",
   "type": "select",
   "default": "units",
   "choices": [
    {
     "id": "units",
     "label": "Include Units"
    },
    {
     "id": "numeric",
     "label": "Numeric Only"
    }
   ],
   "help": "Changing this setting will apply to new values received.  To refresh all variables with the new setting, disable and re-enable the connection after saving these settings."
  }
 ],
 "actions": [
