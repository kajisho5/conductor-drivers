{
 "format": 1,
 "id": "m-creativeland-capacitimer",
 "name": "Creativeland Capacitimer",
 "category": "Creativeland",
 "version": "1.0.1",
 "minAppVersion": "0.6.0",
 "transport": "http",
 "configFields": [
  {
   "id": "baseUrl",
   "label": "URL の先頭",
   "type": "text",
   "default": "http://192.168.0.10",
   "placeholder": "http://192.168.0.10",
   "mono": true
  },
  {
   "id": "discovered",
   "label": "Discovered Capacitimers",
   "type": "select",
   "default": "",
   "choices": [
    {
     "id": "",
     "label": " "
    }
   ],
   "help": "Select a discovered Capacitimer instance from the network"
  }
 ],
 "actions": [
  {
   "id": "start_timer",
   "name": "Start Timer",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/timer/start",
    "body": "",
    "contentType": "application/json"
   }
  },
  {
   "id": "pause_timer",
   "name": "Pause Timer",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/timer/pause",
    "body": "",
    "contentType": "application/json"
   }
  },
  {
   "id": "reset_timer",
   "name": "Reset Timer",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/timer/reset",
    "body": "",
    "contentType": "application/json"
   }
  },
  {
   "id": "adjust_timer",
   "name": "Adjust Timer",
   "options": [
    {
     "id": "seconds",
     "label": "Seconds (positive to add, negative to subtract)",
     "type": "text",
     "default": "30"
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/timer/adjust",
    "body": "{\"seconds\":{{option.seconds}}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "toggle_timer",
   "name": "Toggle Timer (Start/Pause)",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/timer/start",
    "body": "",
    "contentType": "application/json"
   }
  },
  {
   "id": "update_settings",
   "name": "Update Settings",
   "options": [
    {
     "id": "showHours",
     "label": "Show Hours",
     "type": "boolean",
     "default": true
    },
    {
     "id": "showMinutes",
     "label": "Show Minutes",
     "type": "boolean",
     "default": true
    },
    {
     "id": "showSeconds",
     "label": "Show Seconds",
     "type": "boolean",
     "default": true
    },
    {
     "id": "showMilliseconds",
     "label": "Show Milliseconds",
     "type": "boolean",
     "default": false
    },
    {
     "id": "countUpAfterZero",
     "label": "Count Up After Zero",
     "type": "boolean",
     "default": false
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/settings",
    "body": "{\"showHours\":{{option.showHours|map}}e,\"showMinutes\":{{option.showMinutes|map}}e,\"showSeconds\":{{option.showSeconds|map}}e,\"showMilliseconds\":{{option.showMilliseconds|map}}e,\"countUpAfterZero\":{{option.countUpAfterZero|map}}e}",
    "contentType": "application/json"
   },
   "maps": {
    "showHours": {
     "true": "tru",
     "false": "fals"
    },
    "showMinutes": {
     "true": "tru",
     "false": "fals"
    },
    "showSeconds": {
     "true": "tru",
     "false": "fals"
    },
    "showMilliseconds": {
     "false": "fals",
     "true": "tru"
    },
    "countUpAfterZero": {
     "false": "fals",
     "true": "tru"
    }
   }
  },
  {
   "id": "toggle_timer_visibility",
   "name": "Toggle Timer Visibility",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/settings",
    "body": "{\"showTimer\":false}",
    "contentType": "application/json"
   }
  },
  {
   "id": "toggle_time_of_day",
   "name": "Toggle Time of Day",
   "options": [],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/settings",
    "body": "{\"showTimeOfDay\":false}",
    "contentType": "application/json"
   }
  },
  {
   "id": "set_timer_font_size",
   "name": "Set Timer Font Size",
   "options": [
    {
     "id": "fontSize",
     "label": "Font Size (%)",
     "type": "text",
     "default": "100"
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/settings",
    "body": "{\"timerFontSize\":{{option.fontSize}}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "set_time_of_day_font_size",
   "name": "Set Time of Day Font Size",
   "options": [
    {
     "id": "fontSize",
     "label": "Font Size (%)",
     "type": "text",
     "default": "100"
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/settings",
    "body": "{\"timeOfDayFontSize\":{{option.fontSize}}}",
    "contentType": "application/json"
   }
  },
  {
   "id": "set_timer_font",
   "name": "Set Timer Font",
   "options": [
    {
     "id": "font",
     "label": "Font Family",
     "type": "select",
     "default": "Roboto Mono",
     "choices": [
      {
       "id": "Roboto Mono",
       "label": "Roboto Mono"
      },
      {
       "id": "Kode Mono",
       "label": "Kode Mono"
      },
      {
       "id": "PT Mono",
       "label": "PT Mono"
      },
      {
       "id": "Share Tech Mono",
       "label": "Share Tech Mono"
      },
      {
       "id": "Courier Prime",
       "label": "Courier Prime"
      }
     ]
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/settings",
    "body": "{\"timerFont\":\"{{option.font|map}}\"}",
    "contentType": "application/json"
   },
   "maps": {
    "font": {
     "Roboto Mono": "Roboto Mono",
     "Kode Mono": "Kode Mono",
     "PT Mono": "PT Mono",
     "Share Tech Mono": "Share Tech Mono",
     "Courier Prime": "Courier Prime"
    }
   }
  },
  {
   "id": "set_timer_colors",
   "name": "Set Timer Colors",
   "options": [
    {
     "id": "colorNormal",
     "label": "Normal Color (hex)",
     "type": "text",
     "default": "#44ff44"
    },
    {
     "id": "colorWarning",
     "label": "Warning Color (hex)",
     "type": "text",
     "default": "#ffaa00"
    },
    {
     "id": "colorCritical",
     "label": "Critical Color (hex)",
     "type": "text",
     "default": "#ff4444"
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/settings",
    "body": "{\"colorNormal\":\"{{option.colorNormal}}\",\"colorWarning\":\"{{option.colorWarning}}\",\"colorCritical\":\"{{option.colorCritical}}\"}",
    "contentType": "application/json"
   }
  },
  {
   "id": "set_time_of_day_color",
   "name": "Set Time of Day Color",
   "options": [
    {
     "id": "color",
     "label": "Color (hex)",
     "type": "text",
     "default": "#ffffff"
    }
   ],
   "send": {
    "kind": "http",
    "method": "POST",
    "path": "/api/settings",
    "body": "{\"timeOfDayColor\":\"{{option.color}}\"}",
    "contentType": "application/json"
   }
  }
 ],
