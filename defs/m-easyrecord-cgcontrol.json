{
 "format": 1,
 "id": "m-easyrecord-cgcontrol",
 "name": "Easyrecord CG control",
 "category": "Easyrecord",
 "version": "1.1.0",
 "minAppVersion": "0.6.0",
 "transport": "ws",
 "wsPath": "/?&name=CompanionCGModule&id=999&type=11",
 "configFields": [
  {
   "id": "host",
   "label": "IP アドレス",
   "type": "text",
   "placeholder": "192.168.0.10",
   "pattern": "^[A-Za-z0-9.:\\-]+$",
   "mono": true,
   "default": "easyrecord.se"
  },
  {
   "id": "port",
   "label": "ポート",
   "type": "number",
   "default": 8081,
   "min": 1,
   "max": 65535
  },
  {
   "id": "username",
   "label": "Username",
   "type": "text"
  },
  {
   "id": "password",
   "label": "Password",
   "type": "text"
  },
  {
   "id": "competitionCode",
   "label": "Competition code",
   "type": "text"
  }
 ],
 "actions": [
  {
   "id": "background_action",
   "name": "Background",
   "options": [
    {
     "id": "displayId",
     "label": "Display ID",
     "type": "text",
     "default": "999"
    },
    {
     "id": "background",
     "label": "Background",
     "type": "select",
     "default": "none",
     "choices": [
      {
       "id": "none",
       "label": "Transparent"
      },
      {
       "id": "green",
       "label": "Green"
      },
      {
       "id": "black",
       "label": "Black"
      },
      {
       "id": "image",
       "label": "Image"
      }
     ]
    }
   ],
   "send": {
    "kind": "bytes",
    "data": "{\"type\":\"displayControl\",\"display\":\".21.999\",\"command\":\"background(\\\\\"{{option.background|map}}\\\\\")\"}",
    "encoding": "text"
   },
   "maps": {
    "background": {
     "none": "none",
     "green": "green",
     "black": "black",
     "image": "image"
    }
   }
  }
 ],
 "feedbacks": [],
 "variables": [],
 "evidence": [
  {
   "title": "公開 OSS のモジュールから自動変換（MIT）",
   "url": "https://github.com/bitfocus/companion-module-easyrecord-cgcontrol",
   "status": "推測",
   "note": "送る内容だけを変換。実機では未確認。作者：Johan Falkenström"
  }
 ],
 "source": {
  "module": "easyrecord-cgcontrol",
  "version": "1.1.0",
  "license": "MIT",
  "maintainers": [
   "Johan Falkenström"
  ],
  "repository": "git+https://github.com/bitfocus/companion-module-easyrecord-cgcontrol.git"
 }
}
